VB_TOKFORMAT    = 1             ; the token format's version

; tags of the token stream
TAG_EOL         = $00             ; end of a line record
TAG_INTDEC      = $01             ; integer, decimal spelling: 2 bytes
TAG_INTHEX      = $02             ; integer, hexadecimal spelling: 2 bytes
TAG_INTBIN      = $03             ; integer, binary spelling: 2 bytes
TAG_FLOAT       = $04             ; float: 5-byte value, length, spelling
TAG_STRING      = $05             ; string: length, bytes
TAG_VAR         = $06             ; variable: slot (2; bit 15 = a local's frame slot)
TAG_LINEREF     = $07             ; line number (2), cached record address (3)
TAG_NAMEREF     = $08             ; label or procedure: symbol (2), target (3)
TAG_COMMENT     = $09             ; comment: length, raw text
TAG_DATA        = $0A             ; DATA item: length, raw text
TAG_BLOCK       = $0B             ; block partner offset (2)
TAG_EXT         = $FF             ; the second page: the next byte is the token

; per-token flags (vb_flags1/2), first byte
