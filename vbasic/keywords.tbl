# VeraBASIC keyword table: the single source for the token numbers, the
# ca65 tables (vbasic/gen/tokens.inc), the Python tables
# (tools/vbtokens_gen.py), the editor's help (vbasic/gen/HELP/KEYWORDS.HLP)
# and the manual's language reference (docs/vbasic/manual/reference.md).
# tools/vbgen.py reads it; docs/vbasic/FORMAT.md describes the tokens.
#
# MIT licence (LICENSE). The token numbers are VeraBASIC's own.
#
# Lines (fields separated by "|", blanks around them ignored):
#
#   group ID | Title
#       a group of the reference, in this order; its help: lines are the
#       section's introduction
#
#   kw NAME | TOKEN | KIND | ARGS | OVERLAY | KERNEL | GROUP [| FLAGS]
#       NAME     the keyword in upper case; two words ("END IF") make a
#                compound: both words are keywords, the tokenizer joins
#                them into one token
#       TOKEN    $80-$FE (the first page, one byte) or $FFnn (the second
#                page, two bytes: $FF and nn, $01-$FF). Never renumbered;
#                a keyword that goes keeps its number as a retired line
#       KIND     stmt   a statement (or the first word of one)
#                func   a function: a value in an expression
#                op     an operator
#                word   a word that only appears inside statements
#       ARGS     stmt: the arguments by position, separated by ",", [ ]
#                around optional ones; * = the statement's own grammar.
#                func: (args)->type, or ->type for a value with no
#                parentheses, [(args)]->type when they are optional.
#                Codes: n number, i integer, s string, x any, v variable,
#                a array, h #handle, c colour, l line number or label,
#                p procedure name (the tokenizer stores a name in that
#                position as a procedure reference), - none
#       OVERLAY  where the run-time code is: core (resident), gfx, file,
#                dlg (menus, dialogs, icons), snd (sound, sprites), - (no
#                code of its own: a word read by another statement)
#       KERNEL   the kernel calls, variables and SDK helpers it maps to
#                (checked against api/veranda.api and sdk/lib/*.h);
#                VERA: a register, new: a helper still to write, - none
#       GROUP    a group ID
#       FLAGS    block      a block-partner offset ($0B) follows the token
#                ref=line   a number after it is a line reference, a
#                           name a label reference (GOTO ...)
#                ref=stmt   a number after it is a line reference, else a
#                           statement starts (THEN, ELSE)
#                ref=proc   a name after it is a procedure reference
#                raw=rem    the rest of the line is a comment
#                raw=data   at a statement's start: raw DATA items follow
#                value=N    in an expression the word is the number N
#
#   const NAME | VALUE | GROUP [| api=NAME | theme=NAME]
#       a predefined constant: a name, not a token (the tokenizer stores
#       it as a name; prepare marks it constant). api= / theme= say where
#       the value comes from, and the generator checks it
#
#   apiconst PREFIX | GROUP
#       every "const PREFIX..." line of api/veranda.api, as constants
#
#   retired TOKEN | NAME
#       a number that once was a keyword's: never given again
#
# Each kw, const and apiconst line is followed by indented field lines:
#   syntax:  one line (required)
#   help:    the text, one or more lines (required); "help:" alone
#            starts a new paragraph
#   example: a listing, one or more lines (required)
#   see:     related keywords, separated by ","

# ----------------------------------------------------------------------
group program | Programs, lines and comments
  help: A program is plain text, one statement or more a line, separated
  help: by ":". A line may start with a number (a V2-style line number)
  help: or a label ("Start:"). Names have up to 32 letters, digits and
  help: "_", all significant, in any case; "%" at the end makes an
  help: integer, "$" a string, no suffix a float (or an integer after
  help: OPTION INTEGER).

kw REM | $8C | stmt | * | core | - | program | raw=rem
  syntax: REM text   or   ' text
  help: A comment: the rest of the line is kept as it is and ignored.
  help: The apostrophe is the short form and may follow a statement.
  example: REM Bird Watch, version 1
  example: count% = 0   ' birds so far
  see: DATA

kw LET | $84 | stmt | v = x | core | - | program
  syntax: [LET] variable = expression
  help: Gives a variable a value. The word LET may be left out.
  example: LET a% = 1
  example: name$ = "Robin"
  see: CONST, DIM

kw END | $8D | stmt | - | core | - | program
  syntax: END
  help: Ends the program: files are closed, voices silenced, and the
  help: program quits (or returns to the editor).
  example: IF ASK("Quit now?") THEN END
  see: STOP, END IF, END SUB

kw STOP | $8E | stmt | - | core | - | program
  syntax: STOP
  help: Stops the program as if Ctrl+C was pressed: under the editor it
  help: breaks into the debugger at this line; CONT continues. Also the
  help: event word of ON STOP and the timer state of TIMER n STOP.
  example: IF total% < 0 THEN STOP
  see: CONT, END, ON

kw CONT | $8F | stmt | - | core | - | program
  syntax: CONT
  help: Continues a program stopped by STOP, Ctrl+C or a breakpoint.
  help: Used from the editor's Run menu; in a program it does nothing.
  example: CONT
  see: STOP

kw OPTION | $B8 | stmt | * | core | - | program
  syntax: OPTION INTEGER   or   OPTION MEMORY banks
  help: OPTION INTEGER makes names without a suffix 16-bit integers
  help: instead of floats: faster, and what new programs should start
  help: with. OPTION MEMORY gives the variables, arrays and strings that
  help: many 8 KB RAM banks (4 to 24; 4 without it).
  example: OPTION INTEGER
  example: OPTION MEMORY 8
  see: DEFINT, INTEGER, MEMORY

kw INTEGER | $B9 | word | - | - | - | program
  syntax: OPTION INTEGER
  help: The word of OPTION INTEGER: unsuffixed names are integers.
  example: OPTION INTEGER
  see: OPTION, DEFINT

kw MEMORY | $BA | word | - | - | - | program
  syntax: OPTION MEMORY banks
  help: The word of OPTION MEMORY: how many RAM banks the variables,
  help: arrays and strings get.
  example: OPTION MEMORY 12
  see: OPTION, FRE

kw DEFINT | $B7 | stmt | * | core | - | program
  syntax: DEFINT letter[-letter] [, ...]
  help: Names without a suffix whose first letter is in the ranges are
  help: integers (as V2 programs from other BASICs write it). DEFINT A-Z
  help: is OPTION INTEGER.
  example: DEFINT A-Z
  example: DEFINT I-N, X
  see: OPTION

# ----------------------------------------------------------------------
group console | The console: PRINT and INPUT
  help: PRINT and INPUT use the console, a window of 8 x 8 cards that
  help: opens on the first PRINT and scrolls. A V2 listing runs in it
  help: unchanged. With #h they use an open file instead.

kw PRINT | $80 | stmt | * | core | PutCards ScrollRect FWrite | console
  syntax: PRINT [#h,] [value] [{; | ,} value] ... [; | ,]
  help: Writes values to the console, or to file h. ";" joins values
  help: without a gap, "," moves to the next 10-column zone; a ";" or ","
  help: at the end keeps the line open. "?" is short for PRINT.
  example: PRINT "Hello"
  example: PRINT "Birds:"; count%, "Time: "; TIME$
  example: PRINT #1, name$
  see: INPUT, TAB, SPC, OPEN

kw INPUT | $81 | stmt | * | core | PutCards GetNextChar FRead | console
  syntax: INPUT [#h,] ["prompt";] variable [, variable] ...
  help: Reads values typed in the console (with a "?" prompt) or read from
  help: file h, separated by commas, into the variables.
  example: INPUT "Your name"; name$
  example: INPUT #1, x, y
  see: LINE INPUT, GET, INPUTBOX$

kw LINE INPUT | $82 | stmt | * | core | PutCards GetNextChar FRead | console
  syntax: LINE INPUT [#h,] ["prompt";] string-variable
  help: Reads a whole line, commas and quotes included, from the console
  help: or from file h.
  example: LINE INPUT "Note: "; note$
  example: LINE INPUT #1, first$
  see: INPUT, EOF

kw GET | $83 | stmt | * | core | GetNextChar FRead | console
  syntax: GET string-variable   or   GET #h, string-variable, count
  help: Without #: the next key from the queue, "" when none (it does not
  help: wait). With #h: up to count bytes from file h.
  example: GET k$
  example: GET #1, block$, 128
  see: INKEY$, PUT, INPUT

kw TAB | $E9 | func | (n)->s | core | - | console
  syntax: TAB(column)
  help: In PRINT: moves to the column (0 is the left edge).
  example: PRINT "Name"; TAB(20); "Count"
  see: SPC, PRINT

kw SPC | $EA | func | (n)->s | core | - | console
  syntax: SPC(count)
  help: In PRINT: writes count spaces.
  example: PRINT "A"; SPC(5); "B"
  see: TAB, PRINT

# ----------------------------------------------------------------------
group flow | Jumps and decisions
  help: A line number or a label is a jump target. IF has a one-line form
  help: and a block form: THEN at the end of the line starts a block that
  help: END IF closes.

kw GOTO | $85 | stmt | l | core | - | flow | ref=line
  syntax: GOTO line   or   GOTO label
  help: Continues at the line number or the label. The first jump to a
  help: number looks it up; later ones use the cached place.
  example: GOTO 100
  example: GOTO Start
  see: GOSUB, ON, IF

kw GOSUB | $86 | stmt | l | core | - | flow | ref=line
  syntax: GOSUB line   or   GOSUB label
  help: Calls the lines at the target as a subroutine; RETURN comes back
  help: to the statement after the GOSUB. New programs use SUB instead.
  example: GOSUB 900
  example: GOSUB DrawBoard
  see: RETURN, SUB, ON

kw RETURN | $87 | stmt | [x] | core | - | flow
  syntax: RETURN   or   RETURN expression (in a FUNCTION)
  help: Without a value: back from a GOSUB. With one, in a FUNCTION: ends
  help: the function with that value.
  example: RETURN
  example: RETURN w * h
  see: GOSUB, FUNCTION

kw ON | $88 | stmt | * | core | - | flow
  syntax: ON n GOTO|GOSUB targets   or   ON event CALL procedure
  help: ON n GOTO 10, 20, 30 jumps to the n-th target (none when n is out
  help: of range). ON ERROR GOTO line, ON ERROR GOTO 0 and ON STOP are kept
  help: for V2-style programs. ON CLICK, KEY, WHEEL, CLOSE #w and QUIT
  help: bind an event to a SUB (the event model).
  example: ON choice% GOTO 100, 200, 300
  example: ON ERROR GOTO 900
  example: ON CLICK CALL Clicked
  example: ON CLOSE #1 CALL DoQuit
  see: GOTO, CALL, CLICK, ERROR

kw IF | $90 | stmt | * | core | - | flow | block
  syntax: IF condition THEN statements [ELSE statements]   or   IF condition THEN ... [ELSEIF ...] [ELSE ...] END IF
  help: Runs statements when the condition is not 0. With THEN at the end
  help: of the line it starts a block that ends with END IF, with ELSEIF
  help: and ELSE parts. THEN followed by a line number jumps there.
  example: IF x% > 10 THEN x% = 0
  example: IF a$ = "" THEN 200 ELSE PRINT a$
  example: IF score% > best% THEN
  example:   best% = score%
  example: ELSE
  example:   PRINT "Try again"
  example: END IF
  see: THEN, ELSE, ELSEIF, END IF, SELECT CASE

kw THEN | $91 | word | - | - | - | flow | ref=stmt
  syntax: IF condition THEN ...
  help: Separates IF's condition from what it runs. At the end of a line
  help: it starts an IF block.
  example: IF k$ = "q" THEN END
  see: IF, ELSE

kw ELSE | $92 | stmt | - | core | - | flow | block ref=stmt
  syntax: IF ... THEN ... ELSE ...   or   ELSE (in an IF block)
  help: What IF runs when the condition is 0: on the same line in the one-
  help: line form, or the lines up to END IF in a block.
  example: IF n% = 1 THEN PRINT "bird" ELSE PRINT "birds"
  see: IF, ELSEIF, END IF

kw ELSEIF | $93 | stmt | x | core | - | flow | block
  syntax: ELSEIF condition THEN
  help: Inside an IF block: a further condition, tested when the ones
  help: before it were 0.
  example: IF t < 0 THEN
  example:   PRINT "frost"
  example: ELSEIF t < 10 THEN
  example:   PRINT "cold"
  example: END IF
  see: IF, ELSE, END IF

kw END IF | $94 | stmt | - | core | - | flow
  syntax: END IF
  help: Ends an IF block.
  example: IF ok% THEN
  example:   PRINT "Saved"
  example: END IF
  see: IF

# ----------------------------------------------------------------------
group loops | Loops
  help: FOR counts; WHILE tests first, REPEAT and DO ... LOOP UNTIL test
  help: last. EXIT leaves the innermost loop of its kind. An integer FOR
  help: (FOR i% = ...) never touches the float code.

kw FOR | $9B | stmt | * | core | - | loops | block
  syntax: FOR variable = first TO last [STEP step]
  help: Runs the lines up to NEXT with the variable counting from first to
  help: last (by step, 1 if none; a negative step counts down).
  example: FOR i% = 1 TO 10
  example:   PRINT i%
  example: NEXT
  example: FOR x = 1 TO 0 STEP -0.25 : PRINT x : NEXT x
  see: NEXT, TO, STEP, EXIT FOR

kw TO | $9C | word | - | - | - | loops
  syntax: FOR v = a TO b   CASE a TO b   COPY ... TO x, y
  help: The range word of FOR and CASE, and the target of COPY.
  example: FOR i% = 0 TO 79 : NEXT
  see: FOR, CASE, COPY

kw STEP | $9D | word | - | - | - | loops
  syntax: FOR v = a TO b STEP s
  help: The amount FOR adds to its variable each time (1 without STEP).
  example: FOR y% = 470 TO 0 STEP -10 : NEXT
  see: FOR

kw NEXT | $9E | stmt | [v,...] | core | - | loops | block
  syntax: NEXT [variable [, variable] ...]
  help: Ends a FOR loop. With names it ends those loops, innermost first.
  example: FOR i% = 1 TO 3 : FOR j% = 1 TO 3 : PRINT i% * j% : NEXT j%, i%
  see: FOR

kw WHILE | $95 | stmt | x | core | - | loops | block
  syntax: WHILE condition ... WEND
  help: Runs the lines up to WEND as long as the condition is not 0; tested
  help: before each pass.
  example: f$ = DIR$("*.TXT")
  example: WHILE f$ <> ""
  example:   PRINT f$ : f$ = DIR$()
  example: WEND
  see: WEND, EXIT WHILE, DO

kw WEND | $96 | stmt | - | core | - | loops | block
  syntax: WEND
  help: Ends a WHILE loop.
  example: WHILE n% > 0 : n% = n% \ 2 : WEND
  see: WHILE

kw REPEAT | $97 | stmt | - | core | - | loops | block
  syntax: REPEAT ... UNTIL condition
  help: Runs the lines up to UNTIL, then again while the condition is 0;
  help: at least once.
  example: REPEAT
  example:   k$ = INKEY$
  example: UNTIL k$ <> ""
  see: UNTIL, DO

kw UNTIL | $98 | stmt | x | core | - | loops | block
  syntax: UNTIL condition   or   LOOP UNTIL condition
  help: Ends a REPEAT loop; also the test word of DO ... LOOP.
  example: REPEAT : n% = n% + 1 : UNTIL n% = 10
  see: REPEAT, LOOP

kw DO | $99 | stmt | * | core | - | loops | block
  syntax: DO [WHILE|UNTIL condition] ... LOOP [WHILE|UNTIL condition]
  help: A loop with its test at the top, at the bottom, or none (left
  help: with EXIT DO).
  example: DO
  example:   DOEVENTS
  example:   IF INKEY$ = "q" THEN EXIT DO
  example: LOOP
  see: LOOP, EXIT DO, WHILE

kw LOOP | $9A | stmt | * | core | - | loops | block
  syntax: LOOP [WHILE|UNTIL condition]
  help: Ends a DO loop.
  example: DO : i% = i% + 1 : LOOP UNTIL i% = 5
  see: DO

kw EXIT | $A5 | word | - | - | - | loops
  syntax: EXIT FOR|WHILE|DO|REPEAT|SUB|FUNCTION
  help: The first word of the EXIT statements: each leaves the innermost
  help: block of its kind.
  example: EXIT FOR
  see: EXIT FOR, EXIT SUB

kw EXIT FOR | $A6 | stmt | - | core | - | loops | block
  syntax: EXIT FOR
  help: Leaves the innermost FOR loop, past its NEXT.
  example: FOR i% = 0 TO 99 : IF a%(i%) = 0 THEN EXIT FOR
  example: NEXT
  see: FOR, EXIT

kw EXIT WHILE | $A7 | stmt | - | core | - | loops | block
  syntax: EXIT WHILE
  help: Leaves the innermost WHILE loop, past its WEND.
  example: WHILE 1 : IF EOF(1) THEN EXIT WHILE
  example: WEND
  see: WHILE, EXIT

kw EXIT DO | $A8 | stmt | - | core | - | loops | block
  syntax: EXIT DO
  help: Leaves the innermost DO loop, past its LOOP.
  example: DO : IF MOUSEB THEN EXIT DO
  example: LOOP
  see: DO, EXIT

kw EXIT REPEAT | $A9 | stmt | - | core | - | loops | block
  syntax: EXIT REPEAT
  help: Leaves the innermost REPEAT loop, past its UNTIL.
  example: REPEAT : IF k$ = "x" THEN EXIT REPEAT
  example: UNTIL 0
  see: REPEAT, EXIT

# ----------------------------------------------------------------------
group select | Choosing: SELECT CASE
  help: SELECT CASE compares one value with a list of cases and runs the
  help: first that matches.

kw SELECT | $9F | word | - | - | - | select | value=4
  syntax: SELECT CASE expression
  help: The first word of SELECT CASE. In an expression it is the
  help: colour number 4 (the selection colour) of PAPER.
  example: SELECT CASE n%
  example: END SELECT
  see: SELECT CASE, PAPER

kw SELECT CASE | $A0 | stmt | x | core | - | select | block
  syntax: SELECT CASE expression ... END SELECT
  help: Starts a choice between CASE parts: the first CASE whose list
  help: holds the value runs, or CASE ELSE when none does.
  example: SELECT CASE k$
  example:   CASE "a", "e", "i", "o", "u"
  example:     PRINT "vowel"
  example:   CASE ELSE
  example:     PRINT "other"
  example: END SELECT
  see: CASE, CASE ELSE, END SELECT, IF

kw CASE | $A1 | stmt | * | core | - | select | block
  syntax: CASE value [TO value] | IS op value [, ...]
  help: One part of SELECT CASE: values, ranges (1 TO 5) and comparisons
  help: (IS > 9), separated by commas.
  example: SELECT CASE n%
  example:   CASE 1, 2 TO 5, IS > 9
  example:     PRINT "yes"
  example: END SELECT
  see: SELECT CASE, IS, TO

kw CASE ELSE | $A2 | stmt | - | core | - | select | block
  syntax: CASE ELSE
  help: The part of SELECT CASE that runs when no CASE matched; the last.
  example: SELECT CASE d%
  example:   CASE 0 : PRINT "none"
  example:   CASE ELSE : PRINT d%
  example: END SELECT
  see: SELECT CASE, CASE

kw IS | $A3 | word | - | - | - | select
  syntax: CASE IS op value
  help: In CASE: compares the SELECT value with = <> < > <= or >=.
  example: SELECT CASE t : CASE IS < 0 : PRINT "frost" : END SELECT
  see: CASE

kw END SELECT | $A4 | stmt | - | core | - | select
  syntax: END SELECT
  help: Ends a SELECT CASE.
  example: SELECT CASE x% : CASE 1 : PRINT "one" : END SELECT
  see: SELECT CASE

# ----------------------------------------------------------------------
group procs | Procedures
  help: SUB and FUNCTION make procedures with their own parameters and
  help: local variables; they may call themselves. A SUB is called by its
  help: name and its arguments, or with CALL. Scalars are passed by value,
  help: arrays (a%()) and BYREF parameters by reference.

kw SUB | $AC | stmt | * | core | - | procs | block ref=proc
  syntax: SUB Name[(parameter, ...)] ... END SUB
  help: Defines a procedure. Its parameters are local. A SUB is also what
  help: menu items, icons, timers and events call.
  example: SUB Greet(who$)
  example:   PRINT "Hello, "; who$
  example: END SUB
  example: Greet "Robin"
  see: END SUB, CALL, FUNCTION, LOCAL, EXIT SUB

kw END SUB | $AD | stmt | - | core | - | procs
  syntax: END SUB
  help: Ends a SUB; the call returns.
  example: SUB Tick : WINDOW STATUS #1, "", TIME$ : END SUB
  see: SUB

kw FUNCTION | $AE | stmt | * | core | - | procs | block ref=proc
  syntax: FUNCTION Name[(parameter, ...)] ... END FUNCTION
  help: Defines a function: a procedure with a value. Assign the value to
  help: the function's name, or give it with RETURN. The name's suffix is
  help: the value's type.
  example: FUNCTION Area(w, h)
  example:   Area = w * h
  example: END FUNCTION
  example: PRINT Area(3, 4)
  see: END FUNCTION, RETURN, SUB

kw END FUNCTION | $AF | stmt | - | core | - | procs
  syntax: END FUNCTION
  help: Ends a FUNCTION; the call returns its value.
  example: FUNCTION Twice%(n%) : Twice% = 2 * n% : END FUNCTION
  see: FUNCTION

kw EXIT SUB | $AA | stmt | - | core | - | procs | block
  syntax: EXIT SUB
  help: Returns from a SUB at once.
  example: SUB Save : IF f$ = "" THEN EXIT SUB
  example: END SUB
  see: SUB, EXIT FUNCTION

kw EXIT FUNCTION | $AB | stmt | - | core | - | procs | block
  syntax: EXIT FUNCTION
  help: Returns from a FUNCTION at once with the value given so far.
  example: FUNCTION Find%(k$) : Find% = -1 : IF k$ = "" THEN EXIT FUNCTION
  example: END FUNCTION
  see: FUNCTION, RETURN

kw CALL | $B0 | stmt | p | core | - | procs | ref=proc
  syntax: CALL Name[(argument, ...)]
  help: Calls a SUB. The same as writing the name and its arguments; also
  help: the word that binds events and timers to a SUB.
  example: CALL Greet("Robin")
  example: TIMER 1, 60 CALL Tick
  see: SUB, ON, TIMER

kw BYREF | $B1 | word | - | - | - | procs
  syntax: SUB Name(BYREF parameter)
  help: A parameter passed by reference: assigning it changes the
  help: caller's variable.
  example: SUB Swap(BYREF a%, BYREF b%)
  example:   LOCAL t% : t% = a% : a% = b% : b% = t%
  example: END SUB
  see: SUB, FUNCTION

kw LOCAL | $B2 | stmt | v,... | core | - | procs
  syntax: LOCAL name [, name] ...
  help: Inside a procedure: variables of its own, new at each call (so
  help: recursion works), gone at its end.
  example: SUB Count : LOCAL i%, s$
  example: END SUB
  see: SHARED, SUB

kw SHARED | $B3 | stmt | v,... | core | - | procs
  syntax: SHARED name [, name] ...
  help: Inside a procedure: says the names are the program's globals. A
  help: name a procedure does not make LOCAL is global anyway; SHARED says
  help: so on purpose.
  example: SUB Tick : SHARED ticks% : ticks% = ticks% + 1 : END SUB
  see: LOCAL

# ----------------------------------------------------------------------
group data | Data, constants and arrays

kw DATA | $89 | stmt | * | core | - | data | raw=data value=5
  syntax: DATA item [, item] ...
  help: Values for READ, kept as written (numbers, or text in quotes when
  help: it holds commas). In an expression (FOLDER$, PICTURE$) DATA is
  help: the number 5.
  example: DATA 3, "Robin", "Wren", "Blue tit"
  see: READ, RESTORE

kw READ | $8A | stmt | v,... | core | - | data
  syntax: READ variable [, variable] ...
  help: Takes the next DATA items into the variables.
  example: READ n% : FOR i% = 1 TO n% : READ b$ : PRINT b$ : NEXT
  see: DATA, RESTORE

kw RESTORE | $8B | stmt | [l] | core | - | data | ref=line
  syntax: RESTORE [line | label]
  help: The next READ starts at the first DATA again, or at the first
  help: DATA at or after the target.
  example: RESTORE
  example: RESTORE Birds
  see: READ, DATA

kw CONST | $B4 | stmt | v = x | core | - | data
  syntax: CONST name = value
  help: A name for a value that never changes; assigning it is an error.
  example: CONST W% = 640, H% = 480
  see: LET

kw DIM | $B5 | stmt | * | core | - | data
  syntax: DIM name(size [, size [, size]]) [, ...]
  help: Makes arrays of up to 3 dimensions, indices from 0 to size. They
  help: live in RAM banks and may be large.
  example: DIM a%(100), grid$(10, 10)
  see: REDIM, UBOUND

kw REDIM | $B6 | stmt | * | core | - | data
  syntax: REDIM name(size [, ...]) [, ...]
  help: Makes an array again with new sizes; its old values are gone.
  example: REDIM list$(n% * 2)
  see: DIM

kw UBOUND | $EB | func | (a[,n])->i | core | - | data
  syntax: UBOUND(array [, dimension])
  help: The largest index of the array's dimension (1 if none is given).
  example: FOR i% = 0 TO UBOUND(a%) : a%(i%) = 0 : NEXT
  see: DIM

# ----------------------------------------------------------------------
group errors | Errors
  help: An error stops the program unless TRY catches it. ERR, ERR$ and
  help: ERL say what happened and where.

kw TRY | $BB | stmt | - | core | - | errors | block
  syntax: TRY ... CATCH ... END TRY
  help: Runs the lines up to CATCH; an error there runs the lines from
  help: CATCH to END TRY instead of stopping the program.
  example: TRY
  example:   OPEN #1, "Bird list.txt", "r"
  example: CATCH
  example:   MSGBOX "Could not read the list: " + ERR$
  example: END TRY
  see: CATCH, END TRY, ERR, ERROR

kw CATCH | $BC | stmt | - | core | - | errors | block
  syntax: CATCH
  help: Where a TRY block continues after an error.
  example: TRY : KILL f$ : CATCH : PRINT "Not there" : END TRY
  see: TRY

kw END TRY | $BD | stmt | - | core | - | errors
  syntax: END TRY
  help: Ends a TRY block.
  example: TRY : x = 1 / y : CATCH : x = 0 : END TRY
  see: TRY

kw ERROR | $BE | stmt | n[,s] | core | - | errors
  syntax: ERROR number [, message]
  help: Raises an error. 200-255 are free for programs. Also the word of
  help: ON ERROR GOTO.
  example: ERROR 200, "No birds"
  example: ON ERROR GOTO 900
  see: TRY, ERR, ON

kw RESUME | $BF | stmt | * | core | - | errors | ref=line
  syntax: RESUME [NEXT | line | label]
  help: From an ON ERROR GOTO handler: runs the failing statement again,
  help: the one after it (NEXT), or continues at a target.
  example: 900 PRINT "Error"; ERR : RESUME NEXT
  see: ON, ERROR

kw ERR | $EC | func | ->i | core | - | errors
  syntax: ERR
  help: The number of the last error.
  example: TRY : OPEN #1, f$, "r" : CATCH : PRINT ERR : END TRY
  see: ERR$, ERL, ERRFILE

kw ERR$ | $ED | func | ->s | core | - | errors
  syntax: ERR$
  help: The message of the last error.
  example: PRINT "Failed: "; ERR$
  see: ERR, ERL

kw ERL | $EE | func | ->i | core | - | errors
  syntax: ERL
  help: The line of the last error: its line number, or the source line.
  example: PRINT "in line"; ERL
  see: ERR

kw ERRFILE | $EF | func | ->i | core | - | errors
  syntax: ERRFILE
  help: The kernel's error code (its x register) of the last file or
  help: system error; 0 for other errors.
  example: IF ERRFILE = 5 THEN PRINT "no such file"
  see: ERR, OPEN

# ----------------------------------------------------------------------
group operators | Operators
  help: From the highest priority: ^; unary -; * / \ MOD; + -; SHL SHR;
  help: comparisons; NOT; AND; OR XOR. AND, OR, XOR and NOT work on the
  help: bits of integers; a comparison gives -1 (true) or 0.

kw AND | $C8 | op | - | core | - | operators
  syntax: a AND b
  help: Both true; on integers, the bits set in both.
  example: IF MOUSEB AND 1 THEN PRINT "left"
  see: OR, XOR, NOT

kw OR | $C9 | op | - | core | - | operators
  syntax: a OR b
  help: Either true; on integers, the bits set in either.
  example: flags% = flags% OR 4
  see: AND, XOR

kw XOR | $CA | op | - | core | - | operators
  syntax: a XOR b
  help: One true but not both; on integers, the bits that differ.
  example: v% = v% XOR $FF
  see: AND, OR

kw NOT | $CB | op | - | core | - | operators
  syntax: NOT a
  help: True when a is false; on integers, every bit turned over.
  example: IF NOT done% THEN PRINT "busy"
  see: AND

kw MOD | $CC | op | - | core | - | operators
  syntax: a MOD b
  help: The remainder of a divided by b.
  example: IF n% MOD 2 = 0 THEN PRINT "even"
  see: SHL

kw SHL | $CD | op | - | core | - | operators
  syntax: a SHL n
  help: The integer a with its bits moved n places left.
  example: hi% = b% SHL 8
  see: SHR

kw SHR | $CE | op | - | core | - | operators
  syntax: a SHR n
  help: The integer a with its bits moved n places right.
  example: lo% = w% SHR 8
  see: SHL

kw <= | $CF | op | - | core | - | operators
  syntax: a <= b
  help: True when a is less than or equal to b (numbers or strings).
  example: IF x% <= 0 THEN x% = 0
  see: >=, <>

kw <> | $D0 | op | - | core | - | operators
  syntax: a <> b
  help: True when a and b differ.
  example: WHILE k$ <> "q" : k$ = INKEY$ : WEND
  see: <=, >=

kw >= | $D1 | op | - | core | - | operators
  syntax: a >= b
  help: True when a is greater than or equal to b.
  example: IF y% >= 480 THEN y% = 479
  see: <=, <>

# ----------------------------------------------------------------------
group strings | Strings
  help: Strings hold up to 255 Latin-1 characters; + joins them. The first
  help: character is position 1.

kw LEFT$ | $D2 | func | (s,n)->s | core | - | strings
  syntax: LEFT$(s$, n)
  help: The first n characters of s$.
  example: PRINT LEFT$("Robin", 3)
  see: RIGHT$, MID$

kw MID$ | $D3 | func | (s,n[,n])->s | core | - | strings
  syntax: MID$(s$, start [, length])
  help: The characters of s$ from start on (length of them, or all).
  example: PRINT MID$("Blackbird", 6)
  see: LEFT$, RIGHT$

kw RIGHT$ | $D4 | func | (s,n)->s | core | - | strings
  syntax: RIGHT$(s$, n)
  help: The last n characters of s$.
  example: ext$ = RIGHT$(f$, 3)
  see: LEFT$, MID$

kw LEN | $D5 | func | (s)->i | core | - | strings
  syntax: LEN(s$)
  help: The number of characters of s$.
  example: PRINT LEN("Wren")
  see: MID$

kw STR$ | $D6 | func | (n)->s | core | - | strings
  syntax: STR$(number)
  help: A number as text (with a space before a positive number, as V2).
  example: t$ = "Count:" + STR$(count%)
  see: VAL

kw VAL | $D7 | func | (s)->n | core | - | strings
  syntax: VAL(s$)
  help: The number at the start of s$ (0 if none).
  example: n% = VAL(INPUTBOX$("How many?"))
  see: STR$

kw CHR$ | $D8 | func | (n)->s | core | - | strings
  syntax: CHR$(code)
  help: The character with the Latin-1 code.
  example: q$ = CHR$(34)
  see: ASC

kw ASC | $D9 | func | (s)->i | core | - | strings
  syntax: ASC(s$)
  help: The Latin-1 code of the first character of s$.
  example: PRINT ASC("A")
  see: CHR$

# ----------------------------------------------------------------------
group maths | Numbers
  help: Floats use the X16 ROM's maths library (the V2 5-byte format,
  help: about 9 digits). Integer arithmetic stays 16-bit.

kw INT | $DA | func | (n)->n | core | ROM:FLOOR | maths
  syntax: INT(x)
  help: The largest whole number not above x.
  example: PRINT INT(-2.5)
  see: ABS, SGN

kw ABS | $DB | func | (n)->n | core | ROM:ABS | maths
  syntax: ABS(x)
  help: x without its sign.
  example: d% = ABS(x1% - x2%)
  see: SGN

kw SGN | $DC | func | (n)->i | core | ROM:SIGN | maths
  syntax: SGN(x)
  help: -1, 0 or 1 by the sign of x.
  example: dx% = SGN(tx% - x%)
  see: ABS

kw SQR | $DD | func | (n)->n | core | ROM:SQR | maths
  syntax: SQR(x)
  help: The square root of x.
  example: r = SQR(x * x + y * y)
  see: EXP

kw SIN | $DE | func | (n)->n | core | ROM:SIN | maths
  syntax: SIN(x)
  help: The sine of x (radians).
  example: y% = 240 + 100 * SIN(a)
  see: COS, TAN, ATN

kw COS | $DF | func | (n)->n | core | ROM:COS | maths
  syntax: COS(x)
  help: The cosine of x (radians).
  example: x% = 320 + 100 * COS(a)
  see: SIN

kw TAN | $E0 | func | (n)->n | core | ROM:TAN | maths
  syntax: TAN(x)
  help: The tangent of x (radians).
  example: PRINT TAN(0.5)
  see: SIN, ATN

kw ATN | $E1 | func | (n)->n | core | ROM:ATN | maths
  syntax: ATN(x)
  help: The arc tangent of x, in radians.
  example: pi = 4 * ATN(1)
  see: TAN

kw EXP | $E2 | func | (n)->n | core | ROM:EXP | maths
  syntax: EXP(x)
  help: e to the power x.
  example: PRINT EXP(1)
  see: LOG

kw LOG | $E3 | func | (n)->n | core | ROM:LOG | maths
  syntax: LOG(x)
  help: The natural logarithm of x (x > 0).
  example: PRINT LOG(10) / LOG(2)
  see: EXP

kw RND | $E4 | func | (n)->n | core | ROM:RND | maths
  syntax: RND(x)
  help: A random number from 0 up to (not including) 1. A negative x
  help: starts a new sequence from it.
  example: d% = INT(RND(1) * 6) + 1
  see: INT

# ----------------------------------------------------------------------
group system | Memory and the machine

kw PEEK | $E5 | func | (n)->i | core | - | system
  syntax: PEEK(address)
  help: The byte at a main RAM address.
  example: PRINT PEEK($0801)
  see: POKE

kw POKE | $C0 | stmt | n,n | core | - | system
  syntax: POKE address, byte
  help: Writes a byte to main RAM. There is no text screen at $0400; keep
  help: below $A000 and out of the kernel's areas.
  example: POKE $6000, 255
  see: PEEK, SYS

kw SYS | $C1 | stmt | n | core | - | system
  syntax: SYS address
  help: Calls machine code at an address below $A000; it must end with RTS
  help: and leave the zero page from $50 as it found it.
  example: SYS $6000
  see: POKE

kw FRE | $E8 | func | (n)->n | core | - | system
  syntax: FRE(0)
  help: The free bytes of the variables' banks.
  example: PRINT FRE(0); "bytes free"
  see: OPTION

kw TI | $E6 | func | ->n | core | - | system
  syntax: TI
  help: Frames (1/60 s) since the program started.
  example: t = TI : SLEEP 30 : PRINT TI - t
  see: TI$, TIME$, SLEEP

kw TI$ | $E7 | func | ->s | core | hour minutes seconds | system
  syntax: TI$
  help: The clock as "HHMMSS", as V2 had it.
  example: PRINT TI$
  see: TIME$, TI

kw TRON | $C2 | stmt | - | core | LogText | system
  syntax: TRON
  help: Traces the program: each line run goes to the editor's trace
  help: pane (or to the log under Run alone).
  example: TRON
  see: TROFF

kw TROFF | $C3 | stmt | - | core | - | system
  syntax: TROFF
  help: Ends TRON's trace.
  example: TROFF
  see: TRON

# ----------------------------------------------------------------------
group events | Events and the program model
  help: A program runs its main lines, then waits for events: menu items,
  help: icons, clicks, keys, the wheel, timers. Each event calls its SUB,
  help: one at a time, to its end. The menus, the clock and the switcher
  help: keep working while BASIC runs.

kw WAIT | $C5 | stmt | * | core | appMain | events
  syntax: WAIT EVENTS
  help: Ends the main lines and waits for events. Running off the end of
  help: the main lines does the same.
  example: WAIT EVENTS
  see: DOEVENTS, ON, EVENTS

kw EVENTS | $C6 | word | - | - | - | events
  syntax: WAIT EVENTS
  help: The word of WAIT EVENTS.
  example: WAIT EVENTS
  see: WAIT

kw DOEVENTS | $C4 | stmt | - | core | appMain | events
  syntax: DOEVENTS
  help: Inside a long loop: runs the handlers of the events waiting now,
  help: then continues.
  example: FOR i% = 1 TO 1000 : DOEVENTS : NEXT
  see: WAIT, SLEEP

kw SLEEP | $C7 | stmt | n | core | - | events
  syntax: SLEEP frames
  help: Waits that many frames (1/60 s); events are handled meanwhile.
  example: SLEEP 60
  see: TIMER, DOEVENTS

kw CLICK | $FF80 | word | - | - | otherPressVec mouseData | events
  syntax: ON CLICK CALL procedure
  help: The event of a press of the left button outside the menus and
  help: icons, and of its release; MOUSEB has bit 7 set on a release.
  example: ON CLICK CALL Clicked
  see: ON, MOUSEB, MOUSEX

kw KEY | $FF81 | word | - | - | keyVector | events
  syntax: ON KEY CALL procedure
  help: The event of a key; the handler reads KEY$, KEYCODE and KEYMODS.
  example: ON KEY CALL Typed
  see: ON, KEY$, KEYCODE

kw WHEEL | $FF82 | func | ->i | core | GetMouse | events
  syntax: WHEEL   or   ON WHEEL CALL procedure
  help: The wheel's movement since the last read (signed; reading clears
  help: it), and the event of a wheel turn.
  example: ON WHEEL CALL Scrolled
  example: dy% = WHEEL
  see: ON, MOUSEB

kw QUIT | $FF83 | word | - | - | TaskCtl | events
  syntax: ON QUIT CALL procedure
  help: The event of Quit from VeraBASIC Run's own menu while the program
  help: runs; its SUB decides (END quits).
  example: ON QUIT CALL AskQuit
  see: ON, APP

kw TIMER | $FF84 | stmt | * | core | InitProcesses RestartProcess BlockProcess UnblockProcess FreezeProcess | events
  syntax: TIMER n, frames CALL procedure   or   TIMER n ON|OFF|STOP
  help: Timer n (1-8) calls the SUB every so many frames. OFF pauses it,
  help: ON starts it again, STOP ends it.
  example: TIMER 1, 60 CALL Tick
  example: TIMER 1 OFF
  see: CALL, SLEEP, TI

# ----------------------------------------------------------------------
group app | The application
  help: APP lines describe the program for Make application: its name,
  help: class, documents and tile. They do nothing when the program runs.

kw APP | $FF85 | stmt | * | core | - | app
  syntax: APP NAME n$ [, CLASS c$] [, VERSION v$] [, AUTHOR a$] | APP DESCRIPTION d$ | APP DOCUMENTS e$ | APP TILE colour | APP STAY | APP CLASSIC
  help: The application's header (its app.hdr): name, GEOS class,
  help: version, author, description, the file extensions it opens, its
  help: tile and flags.
  example: APP NAME "Bird Watch", CLASS "BirdWatch", VERSION "1.0", AUTHOR "Me"
  example: APP DOCUMENTS "BRD"
  see: NAME, TILE, STAY, CLASSIC

kw NAME | $FF86 | stmt | * | file | FRename | app
  syntax: APP NAME n$   or   NAME old$ AS new$
  help: In APP: the program's name. As a statement: renames a file.
  example: NAME "Draft.txt" AS "Final.txt"
  see: APP, AS

kw CLASS | $FF87 | word | - | - | - | app
  syntax: APP ..., CLASS c$
  help: The program's GEOS class (12 characters), which its documents name.
  example: APP NAME "Notes", CLASS "Notes"
  see: APP

kw VERSION | $FF88 | word | - | - | - | app
  syntax: APP ..., VERSION v$
  help: The program's version, "1.0" style.
  example: APP NAME "Notes", VERSION "1.2"
  see: APP

kw AUTHOR | $FF89 | word | - | - | - | app
  syntax: APP ..., AUTHOR a$
  help: Who wrote the program (19 characters).
  example: APP NAME "Notes", AUTHOR "Me"
  see: APP

kw DESCRIPTION | $FF8A | word | - | - | - | app
  syntax: APP DESCRIPTION d$
  help: The text the shell shows in the program's information (95
  help: characters).
  example: APP DESCRIPTION "Counts the birds at the feeder."
  see: APP

kw DOCUMENTS | $FF8B | word | - | - | - | app
  syntax: APP DOCUMENTS e$ [, e$] ...
  help: Up to four file extensions the shell opens with the program.
  example: APP DOCUMENTS "BRD", "TXT"
  see: APP, DOCUMENT$

kw STAY | $FF8C | word | - | - | TaskCtl | app
  syntax: APP STAY
  help: The program is never put aside; the switcher asks to quit it.
  example: APP STAY
  see: APP, ASIDE

kw CLASSIC | $FF8D | word | - | - | - | app
  syntax: APP CLASSIC
  help: The first menu is not named after the program (the Look 2 rule
  help: is not applied).
  example: APP CLASSIC
  see: MENU

# ----------------------------------------------------------------------
group windows | Windows
  help: A program draws its own window chrome; up to 4 windows. After
  help: WINDOW USE, drawing is relative to that window's body and clipped
  help: to it.

kw WINDOW | $FF8E | stmt | * | gfx | vr_win vr_win_title vr_win_status clipOn windowTopW windowBottomW WRecoverRectangle | windows
  syntax: WINDOW #w, x, y, wc, hc, title$ [, TOOL n] [, STATUS n] [, CLOSE] [, FRAME] [, SHADOW]   or   WINDOW TITLE|STATUS|USE|BACK|FRONT|CLOSE #w ...
  help: Opens window w (1-4) at card x, y, wc cards wide and hc high, with
  help: a title and options: a tool band and a status band of n rows, a
  help: close glyph, a frame, a shadow. The second form changes it.
  example: WINDOW #1, 10, 6, 60, 40, "Bird Watch", CLOSE, FRAME, SHADOW, STATUS 2
  example: WINDOW TITLE #1, "Bird Watch - Garden"
  example: WINDOW USE #1
  see: TITLE, STATUS, USE, CLOSE, HIT

kw TITLE | $FF8F | word | - | - | vr_win_title | windows | value=5
  syntax: WINDOW TITLE #w, title$
  help: Changes a window's title. In an expression TITLE is the colour
  help: number 5 (the title bars' colour) of PAPER.
  example: WINDOW TITLE #1, f$
  see: WINDOW

kw STATUS | $FF90 | word | - | - | vr_win_status | windows
  syntax: WINDOW STATUS #w, left$, right$   or   WINDOW ..., STATUS rows
  help: Writes a window's status band, left and right; as a WINDOW option,
  help: how many rows it has.
  example: WINDOW STATUS #1, "12 birds", TIME$
  see: WINDOW

kw TOOL | $FF91 | word | - | - | - | windows
  syntax: WINDOW ..., TOOL rows
  help: A tool band of that many rows under the title.
  example: WINDOW #1, 0, 2, 80, 56, "Sketch", TOOL 3
  see: WINDOW

kw SHADOW | $FF92 | word | - | - | - | windows
  syntax: WINDOW ..., SHADOW
  help: A shadow right of and below the window.
  example: WINDOW #2, 20, 10, 30, 12, "About", FRAME, SHADOW
  see: WINDOW, FRAME

kw USE | $FF93 | word | - | - | clipOn windowTopW windowBottomW | windows
  syntax: WINDOW USE #w
  help: Draws into window w: coordinates from its body's corner, clipped
  help: to the body.
  example: WINDOW USE #1 : CLS : TEXT 4, 12, "Hello"
  see: WINDOW, BODYTOP

kw BACK | $FF94 | word | - | - | vr_win | windows
  syntax: WINDOW BACK #w
  help: Draws window w as not in front (a plain title band).
  example: WINDOW BACK #2
  see: FRONT

kw FRONT | $FF95 | word | - | - | vr_win | windows
  syntax: WINDOW FRONT #w
  help: Draws window w as the front one.
  example: WINDOW FRONT #1
  see: BACK

kw CLOSE | $FF96 | stmt | * | file | FClose WRecoverRectangle vr_win_hit | windows
  syntax: CLOSE [#h [, #h] ...]   or   WINDOW CLOSE #w   or   WINDOW ..., CLOSE
  help: Closes files (all of them without a number). WINDOW CLOSE erases a
  help: window; as a WINDOW option, a close glyph; ON CLOSE #w is its event.
  example: CLOSE #1
  example: WINDOW CLOSE #2
  see: OPEN, WINDOW, ON

kw HIT | $FF97 | func | (h,n,n)->i | gfx | vr_win_hit | windows
  syntax: HIT(#w, x, y)
  help: Where a point is in window w: 0 outside, 1 title, 2 close glyph,
  help: 3 tool band, 4 body, 5 status band.
  example: IF HIT(#1, MOUSEX, MOUSEY) = 1 THEN PRINT "title"
  see: WINDOW, MOUSEX

kw BODYTOP | $FF98 | func | (h)->i | gfx | vr_win_top | windows
  syntax: BODYTOP(#w)
  help: The first pixel row of window w's body.
  example: y% = BODYTOP(#1) + 4
  see: BODYBOTTOM

kw BODYBOTTOM | $FF99 | func | (h)->i | gfx | vr_win_bottom | windows
  syntax: BODYBOTTOM(#w)
  help: The last pixel row of window w's body.
  example: h% = BODYBOTTOM(#1) - BODYTOP(#1) + 1
  see: BODYTOP

kw SCREEN | $FF9A | stmt | * | gfx | vr_bar_title | windows
  syntax: SCREEN FULL [title$]
  help: A full-screen program under the menu bar (as Paint), with the
  help: title in the bar.
  example: SCREEN FULL "Sketch"
  see: FULL, WINDOW

kw FULL | $FF9B | word | - | - | - | windows
  syntax: SCREEN FULL
  help: The word of SCREEN FULL.
  example: SCREEN FULL
  see: SCREEN

# ----------------------------------------------------------------------
group menus | Menus
  help: MENU lines build the menu bar; MENU SHOW puts it up. Each ITEM
  help: names the SUB it calls.

kw MENU | $FF9C | stmt | * | dlg | DoMenu GotoFirstMenu theme_menus | menus
  syntax: MENU title$   or   MENU SHOW   or   MENU ENABLE menu$, item$, on
  help: Starts a menu of the bar (its ITEMs follow, up to END MENU or the
  help: next MENU). MENU SHOW builds and shows the bar; MENU ENABLE disables
  help: an item (0: shown in parentheses) or enables it again (1).
  example: MENU "File" : ITEM "Open...", DoOpen, "O" : ITEM "Quit", DoQuit, "Q"
  example: MENU SHOW
  example: MENU ENABLE "Edit", "Cut", 0
  see: ITEM, SHOW, END MENU, CHECK

kw ITEM | $FF9D | stmt | s[,p[,s]] | dlg | DoMenu keyVector | menus
  syntax: ITEM text$ [, procedure [, key$]]
  help: A menu item that calls the SUB, with a keyboard shortcut (Ctrl and
  help: the key, shown at the menu's right). ITEM "-" is not an item: the
  help: next item starts a group, under a dotted line.
  example: ITEM "About Notes", About
  example: ITEM "Save", DoSave, "S"
  see: MENU

kw CHECK | $FF9E | stmt | s,n | dlg | DoMenu | menus
  syntax: CHECK item$, on
  help: Puts a check mark ("*") before a menu item (1) or takes it away (0).
  example: CHECK "Bold", 1
  see: ITEM, MENU

kw END MENU | $FF9F | stmt | - | dlg | - | menus
  syntax: END MENU
  help: Ends a menu's ITEM lines (optional).
  example: MENU "Edit" : ITEM "Copy", DoCopy, "C" : END MENU
  see: MENU

kw SHOW | $FFA0 | word | - | - | DoMenu | menus
  syntax: MENU SHOW
  help: The word of MENU SHOW.
  example: MENU SHOW
  see: MENU

kw ENABLE | $FFA1 | word | - | - | - | menus
  syntax: MENU ENABLE menu$, item$, on
  help: The word of MENU ENABLE.
  example: MENU ENABLE "File", "Save", 1
  see: MENU

# ----------------------------------------------------------------------
group dialogs | Dialogs

kw MSGBOX | $FFA2 | stmt | s[,s] | dlg | DoDlgBox | dialogs
  syntax: MSGBOX text$ [, title$]
  help: A dialog box with the text (CHR$(10) starts a new line), the title
  help: in bold, and OK.
  example: MSGBOX "Saved."
  see: ASK, INPUTBOX$

kw ASK | $FFA3 | func | (s)->i | dlg | DoDlgBox PlaySound | dialogs
  syntax: ASK(question$)
  help: A dialog box with Yes and No: 1 for Yes, 0 for No.
  example: IF ASK("Discard changes?") THEN END
  see: MSGBOX

kw INPUTBOX$ | $FFA4 | func | (s[,s[,n]])->s | dlg | DoDlgBox GetString | dialogs
  syntax: INPUTBOX$(prompt$ [, default$ [, length]])
  help: A dialog box that asks for a line of text; "" on Cancel.
  example: n$ = INPUTBOX$("Your name:")
  see: INPUT, ASK

kw FILEOPEN$ | $FFA5 | func | (s[,s])->s | dlg | vr_file | dialogs
  syntax: FILEOPEN$(title$ [, extension$])
  help: The Open dialog (long names, folders, a type filter): the name
  help: chosen, "" on Cancel; its folder becomes the current one (CURDIR$).
  example: f$ = FILEOPEN$("Open a list", "TXT")
  see: FILESAVE$, CURDIR$, OPEN

kw FILESAVE$ | $FFA6 | func | (s,s)->s | dlg | vr_file | dialogs
  syntax: FILESAVE$(title$, default$)
  help: The Save dialog: a name of up to 63 characters, "" on Cancel.
  example: f$ = FILESAVE$("Save as", "Birds 2026.txt")
  see: FILEOPEN$

kw DIALOG | $FFA7 | stmt | n,n,n,n | dlg | DoDlgBox | dialogs | block
  syntax: DIALOG x, y, w, h ... END DIALOG
  help: A dialog box of your own at cards x, y, w by h: LABEL, FIELD and
  help: BUTTON lines up to END DIALOG; DIALOG RESULT tells how it closed.
  example: DIALOG 20, 10, 30, 12
  example:   LABEL 2, 2, "Size"
  example:   FIELD 10, 2, s$, 3
  example:   BUTTON OK : BUTTON CANCEL
  example: END DIALOG
  see: LABEL, FIELD, BUTTON, DIALOG RESULT

kw END DIALOG | $FFA8 | stmt | - | dlg | DoDlgBox | dialogs
  syntax: END DIALOG
  help: Ends a DIALOG block and shows the box until a button closes it.
  example: DIALOG 20, 10, 20, 6 : BUTTON OK : END DIALOG
  see: DIALOG

kw RESULT | $FFA9 | word | - | - | - | dialogs
  syntax: DIALOG RESULT
  help: The word of DIALOG RESULT.
  example: IF DIALOG RESULT = 1 THEN PRINT "OK"
  see: DIALOG RESULT

kw DIALOG RESULT | $FFAA | func | ->i | dlg | - | dialogs
  syntax: DIALOG RESULT
  help: How the last DIALOG closed: 1 OK, 2 Cancel.
  example: IF DIALOG RESULT = 1 THEN size% = VAL(s$)
  see: DIALOG, BUTTON

kw LABEL | $FFAB | stmt | n,n,s | dlg | - | dialogs
  syntax: LABEL x, y, text$
  help: In a DIALOG: text at cards x, y of the box.
  example: LABEL 2, 2, "Width:"
  see: DIALOG, FIELD

kw FIELD | $FFAC | stmt | n,n,v,n | dlg | GetString | dialogs
  syntax: FIELD x, y, string-variable, length
  help: In a DIALOG: a text field that edits the variable.
  example: FIELD 10, 2, w$, 4
  see: DIALOG, LABEL

kw BUTTON | $FFAD | stmt | * | dlg | DoDlgBox | dialogs
  syntax: BUTTON OK | CANCEL
  help: In a DIALOG: an OK or a Cancel button.
  example: BUTTON OK
  see: DIALOG, OK, CANCEL

kw OK | $FFAE | word | - | - | - | dialogs
  syntax: BUTTON OK
  help: The OK button of a DIALOG.
  example: BUTTON OK
  see: BUTTON

kw CANCEL | $FFAF | word | - | - | - | dialogs
  syntax: BUTTON CANCEL
  help: The Cancel button of a DIALOG.
  example: BUTTON CANCEL
  see: BUTTON

# ----------------------------------------------------------------------
group icons | Icons, tiles and pictures
  help: Pictures are strings in GEOS's compacted bitmap form, made by
  help: PICTURE$ from a file or from DATA lines of "#" and ".".

kw ICON | $FFB0 | stmt | i,n,n,s,p | dlg | DoIcons | icons
  syntax: ICON id, x, y, picture$, procedure   or   ICON OFF id
  help: An icon at pixel x, y that calls the SUB when clicked; ICON OFF
  help: takes it away.
  example: ICON 1, 16, 40, brush$, PickBrush
  example: ICON OFF 1
  see: ICONS, PICTURE$, BITMAP

kw ICONS | $FFB1 | stmt | * | dlg | DoIcons | icons
  syntax: ICONS CLEAR
  help: Takes all icons away.
  example: ICONS CLEAR
  see: ICON

kw OFF | $FFB2 | word | - | - | - | icons
  syntax: ICON OFF id   TIMER n OFF   SPRITE n OFF   SOUND OFF
  help: Turns a thing off: an icon, a timer, a sprite, the voices.
  example: SPRITE 2 OFF
  see: ICON, TIMER, SPRITE, SOUND

kw CLEAR | $FFB3 | word | - | - | - | icons
  syntax: ICONS CLEAR
  help: The word of ICONS CLEAR.
  example: ICONS CLEAR
  see: ICONS

kw TILE | $FFB4 | stmt | * | gfx | new:vr_tile | icons
  syntax: TILE x, y, name$ [, colour]   or   APP TILE colour   or   TILE DATA row$, ...
  help: Draws a program's tile at cards x, y (as the shell does). APP TILE
  help: and TILE DATA give the program's own tile: a colour and 32 rows of
  help: 32 "#" and ".".
  example: TILE 2, 4, "Veranda Edit"
  example: APP TILE SKY
  see: APP, ICON

kw BITMAP | $FFB5 | stmt | n,n,s | gfx | WBitmapUp | icons
  syntax: BITMAP x, y, picture$
  help: Draws a picture at pixel x, y.
  example: BITMAP 100, 60, logo$
  see: PICTURE$, ICON

kw PICTURE$ | $FFB6 | func | (x)->s | gfx | - | icons
  syntax: PICTURE$(file$)   or   PICTURE$(DATA)
  help: A picture read from a file, or from the next DATA items: its
  help: width and height, then rows of "#" (ink) and "." (paper).
  example: brush$ = PICTURE$(DATA)
  example: DATA 8, 2, "#..##..#", ".##..##."
  see: BITMAP, ICON, SPRITE

kw PICTURE | $FFB7 | word | - | - | - | icons
  syntax: CLIPBOARD PICTURE x1, y1, x2, y2
  help: The word of CLIPBOARD PICTURE.
  example: CLIPBOARD PICTURE 0, 0, 63, 63
  see: CLIPBOARD

# ----------------------------------------------------------------------
group graphics | Graphics
  help: Coordinates are pixels at 640 x 480 (in the window's body after
  help: WINDOW USE). The screen has one ink colour; colour comes from the
  help: paper of 8 x 8 cards (PAPER).

kw CLS | $FFB8 | stmt | - | gfx | WRectangle | graphics
  syntax: CLS
  help: Clears the window's body (or the screen) to paper.
  example: CLS
  see: BOX, PAPER

kw PATTERN | $FFB9 | stmt | n | gfx | SetPattern | graphics
  syntax: PATTERN n
  help: The fill pattern of BOX (0-33, GEOS's patterns; 0 paper, 1 ink,
  help: the default).
  example: PATTERN 2 : BOX 10, 10, 100, 50
  see: BOX

kw BOX | $FFBA | stmt | n,n,n,n | gfx | WRectangle | graphics
  syntax: BOX x1, y1, x2, y2
  help: A rectangle filled with the pattern.
  example: BOX 10, 10, 100, 50
  see: FRAME, INVERT, PATTERN

kw FRAME | $FFBB | stmt | n,n,n,n | gfx | WFrameRectangle | graphics
  syntax: FRAME x1, y1, x2, y2   or   WINDOW ..., FRAME
  help: A rectangle's outline in ink; as a WINDOW option, a frame round
  help: the window.
  example: FRAME 10, 10, 100, 50
  see: BOX, WINDOW

kw INVERT | $FFBC | stmt | n,n,n,n | gfx | WInvertRectangle | graphics
  syntax: INVERT x1, y1, x2, y2
  help: Turns a rectangle's ink and paper over.
  example: INVERT 0, 0, 79, 15
  see: BOX

kw LINE | $FFBD | stmt | n,n,n,n[,n] | gfx | WDrawLine | graphics
  syntax: LINE x1, y1, x2, y2 [, INK | ERASE]
  help: A line in ink (or paper with ERASE). LINE INPUT is a different
  help: statement.
  example: LINE 0, 0, 639, 479
  example: LINE 10, 20, 30, 40, ERASE
  see: PLOT, LINE INPUT

kw PLOT | $FFBE | stmt | n,n[,n] | gfx | WDrawPoint | graphics
  syntax: PLOT x, y [, ERASE]
  help: One point in ink (or paper).
  example: PLOT MOUSEX, MOUSEY
  see: POINT, LINE

kw POINT | $FFBF | func | (n,n)->i | gfx | WTestPoint | graphics
  syntax: POINT(x, y)
  help: 1 when the point is ink, 0 when paper.
  example: IF POINT(x%, y%) THEN PRINT "ink"
  see: PLOT

kw COPY | $FFC0 | stmt | * | gfx | CopyRect | graphics
  syntax: COPY x, y, w, h TO x2, y2
  help: Copies a rectangle of the screen, x and width in cards, y and
  help: height in pixels.
  example: COPY 0, 16, 40, 100 TO 40, 16
  see: SCROLL

kw SCROLL | $FFC1 | stmt | n,n,n,n,n | gfx | ScrollRect | graphics
  syntax: SCROLL x, w, top, bottom, dy
  help: Moves the rows from top to bottom by dy pixels (x and width in
  help: cards).
  example: SCROLL 0, 80, 16, 479, -8
  see: COPY

kw POINTER | $FFC2 | stmt | n | gfx | SetPointer | graphics
  syntax: POINTER ARROW | BUSY | IBEAM | CROSS
  help: The pointer's shape.
  example: POINTER BUSY
  see: MOUSEX

# ----------------------------------------------------------------------
group text | Text and fonts

kw TEXT | $FFC3 | stmt | n,n,s | gfx | WPutString | text
  syntax: TEXT x, y, s$
  help: Draws s$ in the current font and style, y the baseline.
  example: TEXT 20, 30, "Hello"
  see: FONT, STYLE, CARDS

kw FONT | $FFC4 | stmt | * | gfx | LoadFont UseFont | text
  syntax: FONT name$, size   or   FONT UI   or   FONT SYSTEM
  help: The font of TEXT: one from the fonts folder, the UI font or the
  help: system font.
  example: FONT "Roma", 12
  example: FONT UI
  see: TEXT, FONTHEIGHT

kw STYLE | $FFC5 | stmt | n | gfx | currentMode | text
  syntax: STYLE style
  help: The style of TEXT: 0 plain, or BOLD, ITALIC, UNDERLINE, OUTLINE,
  help: REVERSE added together.
  example: STYLE BOLD + ITALIC
  see: TEXT

kw TEXTWIDTH | $FFC6 | func | (s)->i | gfx | GetCharWidth | text
  syntax: TEXTWIDTH(s$)
  help: The width in pixels of s$ in the current font and style.
  example: x% = 320 - TEXTWIDTH(t$) \ 2
  see: FONTHEIGHT

kw FONTHEIGHT | $FFC7 | func | ->i | gfx | FontInfo | text
  syntax: FONTHEIGHT
  help: The height in pixels of the current font.
  example: y% = y% + FONTHEIGHT
  see: TEXTWIDTH

kw CARDS | $FFC8 | stmt | n,n,s[,n] | gfx | PutCards | text
  syntax: CARDS column, row, s$ [, REVERSE | BOLD]
  help: Fast text in the ROM's 8 x 8 font on the card grid (80 x 60).
  example: CARDS 0, 2, "Score: " + STR$(s%), BOLD
  see: TEXT, PAPER

# ----------------------------------------------------------------------
group colour | Colour
  help: VERA at 1 bit a pixel has one ink for the whole screen and a
  help: paper colour for each 8 x 8 card. Colour means PAPER areas in the
  help: colours of Veranda's look.

kw PAPER | $FFC9 | stmt | n,n,n,n,c | gfx | ColorRect | colour | value=0
  syntax: PAPER column, row, w, h, colour
  help: Sets the paper colour of a rectangle of cards. In an expression
  help: PAPER is the colour number 0 (the paper).
  example: PAPER 0, 2, 80, 1, YELLOW
  see: CARDCOLOR, INK

kw CARDCOLOR | $FFCA | func | (n,n)->i | gfx | GetCardColor | colour
  syntax: CARDCOLOR(column, row)
  help: The paper colour of a card.
  example: IF CARDCOLOR(5, 5) = RED THEN PRINT "red"
  see: PAPER

kw INK | $FFCB | stmt | n | gfx | SetColors | colour | value=1
  syntax: INK rgb   or   LINE ..., INK
  help: The screen's one ink colour as $RGB. In an expression INK is the
  help: number 1 (the ink: a drawing mode, or the colour number).
  example: INK $223
  see: PALETTE, PAPER

kw PALETTE | $FFCC | stmt | n,n | gfx | SetColors | colour
  syntax: PALETTE n, rgb
  help: Sets palette entry n (12-15 only; 0-11 are the look's) to $RGB.
  example: PALETTE 12, $F80
  see: INK

# ----------------------------------------------------------------------
group input | Mouse and keyboard

kw MOUSEX | $FFCD | func | ->i | core | mouseXPos | input
  syntax: MOUSEX
  help: The pointer's x (0-639).
  example: PLOT MOUSEX, MOUSEY
  see: MOUSEY, MOUSEB

kw MOUSEY | $FFCE | func | ->i | core | mouseYPosW | input
  syntax: MOUSEY
  help: The pointer's y (0-479).
  example: PRINT MOUSEX; MOUSEY
  see: MOUSEX

kw MOUSEB | $FFCF | func | ->i | core | mouseButtons mouseData | input
  syntax: MOUSEB
  help: The buttons: bit 0 left, 1 right, 2 middle; in a click handler bit
  help: 7 set on a release.
  example: IF MOUSEB AND 2 THEN PRINT "right"
  see: CLICK, MOUSEX

kw MOUSEIN | $FFD0 | func | (n,n,n,n)->i | core | WIsMseInRegion | input
  syntax: MOUSEIN(x1, y1, x2, y2)
  help: 1 when the pointer is in the rectangle.
  example: IF MOUSEIN(0, 0, 99, 99) THEN PRINT "corner"
  see: MOUSEX, HIT

kw MOUSE | $FFD1 | stmt | * | core | WSetMouseRegion | input
  syntax: MOUSE LIMIT x1, y1, x2, y2
  help: Keeps the pointer inside the rectangle.
  example: MOUSE LIMIT 0, 16, 639, 479
  see: LIMIT

kw LIMIT | $FFD2 | word | - | - | - | input
  syntax: MOUSE LIMIT x1, y1, x2, y2
  help: The word of MOUSE LIMIT.
  example: MOUSE LIMIT 100, 100, 539, 379
  see: MOUSE

kw INKEY$ | $FFD3 | func | ->s | core | GetNextChar | input
  syntax: INKEY$
  help: The next key from the queue as a string, "" when none; never waits.
  example: k$ = INKEY$ : IF k$ <> "" THEN PRINT k$
  see: GET, KEY$, KEYCODE

kw KEY$ | $FFD4 | func | ->s | core | keyData | input
  syntax: KEY$
  help: In a key handler: the key as a string.
  example: SUB Typed : PRINT KEY$; : END SUB
  see: KEY, KEYCODE

kw KEYCODE | $FFD5 | func | ->i | core | keyData | input
  syntax: KEYCODE
  help: In a key handler: the key's code (compare with KEY_LEFT ...).
  example: IF KEYCODE = KEY_LEFT THEN x% = x% - 8
  see: KEY$, KEYMODS

kw KEYMODS | $FFD6 | func | ->i | core | keyMods keyDataMods | input
  syntax: KEYMODS
  help: The modifier keys: Shift 1, Ctrl 2, Alt 4, GUI 8.
  example: IF KEYMODS AND 2 THEN PRINT "Ctrl"
  see: KEYCODE

# ----------------------------------------------------------------------
group sound | Sound

kw SOUND | $FFD7 | stmt | * | snd | PlaySound | sound
  syntax: SOUND id   or   SOUND OFF
  help: Plays a system sound (SND_ERROR ...; silent when the settings say
  help: so). SOUND OFF silences all the program's voices.
  example: SOUND SND_ERROR
  example: SOUND OFF
  see: BEEP, VOICE, PLAY

kw BEEP | $FFD8 | stmt | - | snd | Beep | sound
  syntax: BEEP
  help: The system beep.
  example: IF n% < 0 THEN BEEP
  see: SOUND

kw VOICE | $FFD9 | stmt | n,n,n[,n[,n]] | snd | VERA:PSG | sound
  syntax: VOICE v, frequency, volume [, wave [, width]]
  help: Sets PSG voice v (0-13) directly: frequency in Hz, volume 0-63,
  help: wave PULSE, SAWTOOTH, TRIANGLE or NOISE, the pulse width 0-63.
  example: VOICE 0, 440, 63, PULSE
  example: VOICE 0, 0, 0
  see: PLAY, SOUND

kw PLAY | $FFDA | stmt | n,s | snd | vr_set_irq VERA:PSG | sound
  syntax: PLAY v, music$
  help: Plays a tune on voice v in the background: T tempo, O octave, notes
  help: C D E F G A B with # and a length, R a rest.
  example: PLAY 0, "T120 O4 C8 E8 G4"
  see: VOICE

# ----------------------------------------------------------------------
group files | Files and folders
  help: Files have long names (up to 63 characters, no comma); at most 3 are
  help: open. A kernel's error becomes a catchable error (50 File not found,
  help: 51 Too many files ...) with ERRFILE the kernel's code.

kw OPEN | $FFDB | stmt | h,s,s | file | FOpen | files
  syntax: OPEN #h, name$, mode$
  help: Opens a file as handle h (1-255; 3 files open at most): mode "r"
  help: read, "w" write (a new file, or the old one replaced), "m" read and
  help: write (the file must be there). A name may hold a folder
  help: ("Lists/Birds.txt"), 64 characters in all.
  example: OPEN #1, "Holiday photos from the lake.txt", "w"
  see: CLOSE, PRINT, INPUT, EOF

kw PUT | $FFDC | stmt | h,s | file | FWrite | files
  syntax: PUT #h, s$
  help: Writes the bytes of s$ to file h, nothing added.
  example: PUT #1, CHR$(0) + CHR$(1)
  see: GET, PRINT

kw SEEK | $FFDD | stmt | h,n | file | FSeek | files
  syntax: SEEK #h, position
  help: Moves file h's position (0 is the first byte).
  example: SEEK #1, 0
  see: LOC, LOF

kw LOF | $FFDE | func | (n)->n | file | FSize | files
  syntax: LOF(h)
  help: The size of file h in bytes (up to 16 MB: a float above 32767).
  example: PRINT LOF(1); "bytes"
  see: LOC, EOF

kw LOC | $FFDF | func | (n)->n | file | FSeek | files
  syntax: LOC(h)
  help: The position of file h.
  example: p = LOC(1)
  see: SEEK, LOF

kw EOF | $FFE0 | func | (n)->i | file | FRead | files
  syntax: EOF(h)
  help: True (-1) at the end of file h.
  example: WHILE NOT EOF(1) : LINE INPUT #1, l$ : PRINT l$ : WEND
  see: LINE INPUT, LOF

kw KILL | $FFE1 | stmt | s | file | FDelete | files
  syntax: KILL name$
  help: Deletes a file.
  example: KILL "Old notes.txt"
  see: NAME

kw AS | $FFE2 | word | - | - | - | files
  syntax: NAME old$ AS new$
  help: The word of NAME ... AS.
  example: NAME a$ AS b$
  see: NAME

kw MKDIR | $FFE3 | stmt | s | file | MkDir | files
  syntax: MKDIR path$
  help: Makes a folder.
  example: MKDIR "Birds"
  see: RMDIR, CHDIR

kw RMDIR | $FFE4 | stmt | s | file | RmDir | files
  syntax: RMDIR path$
  help: Removes an empty folder.
  example: RMDIR "Birds"
  see: MKDIR

kw CHDIR | $FFE5 | stmt | s | file | ChDir | files
  syntax: CHDIR path$
  help: Makes a folder the current one.
  example: CHDIR FOLDER$(DOCS)
  see: CURDIR$, FOLDER$

kw CURDIR$ | $FFE6 | func | ->s | file | curDirName | files
  syntax: CURDIR$
  help: The current folder's path.
  example: PRINT CURDIR$
  see: CHDIR

kw DIR$ | $FFE7 | func | [(s)]->s | file | DirOpen DirNext | files
  syntax: DIR$(pattern$)   then   DIR$()
  help: The first name in the current folder matching the pattern ("*" any
  help: run, "?" any one, either case), then with DIR$() the next ones; ""
  help: when there are no more. A folder's name ends with "/".
  example: f$ = DIR$("*.TXT") : WHILE f$ <> "" : PRINT f$ : f$ = DIR$() : WEND
  see: CHDIR, KILL

kw FOLDER$ | $FFE8 | func | (n)->s | file | - | files
  syntax: FOLDER$(DOCS | APPS | FONTS | SYSTEM | DATA)
  help: The path of one of the card's folders.
  example: CHDIR FOLDER$(DOCS)
  see: CHDIR

kw DOCUMENT$ | $FFE9 | func | ->s | file | dataLongName longNames | files
  syntax: DOCUMENT$
  help: The document a made application was opened with (its long name),
  help: "" if none; under VeraBASIC Run always "".
  example: IF DOCUMENT$ <> "" THEN OPEN #1, DOCUMENT$, "r"
  see: DOCUMENTS, FILEOPEN$

kw CLIPBOARD$ | $FFEA | func | ->s | file | scrap_get_text | files
  syntax: CLIPBOARD$
  help: The clipboard's text (the Text Scrap, plain, 255 characters at
  help: most); a line ends with CHR$(10).
  example: t$ = CLIPBOARD$
  see: CLIPBOARD

kw CLIPBOARD | $FFEB | stmt | * | file | scrap_put_text scrap_put_photo | files
  syntax: CLIPBOARD s$   or   CLIPBOARD PICTURE x1, y1, x2, y2
  help: Puts text on the clipboard (the Text Scrap), or a rectangle of the
  help: screen (the Photo Scrap).
  example: CLIPBOARD "copied text"
  see: CLIPBOARD$, PICTURE

# ----------------------------------------------------------------------
group time | Time, sprites and the switcher

kw TIME$ | $FFEC | func | ->s | core | hour minutes seconds | time
  syntax: TIME$
  help: The time as "HH:MM:SS".
  example: WINDOW STATUS #1, "", TIME$
  see: DATE$, TI$

kw DATE$ | $FFED | func | ->s | core | year month day | time
  syntax: DATE$
  help: The date as "YYYY-MM-DD".
  example: PRINT DATE$
  see: TIME$

kw SPRITE | $FFEE | stmt | * | snd | DrawSprite WPosSprite EnablSprite DisablSprite | time
  syntax: SPRITE n, picture$   or   SPRITE n AT x, y   or   SPRITE n ON|OFF
  help: Sprites 2-7 (0 is the pointer, 1 the text cursor): a 24 x 21
  help: picture, a place, shown or hidden.
  example: SPRITE 2, ball$ : SPRITE 2 AT 100, 100 : SPRITE 2 ON
  see: AT, PICTURE$

kw AT | $FFEF | word | - | - | - | time
  syntax: SPRITE n AT x, y
  help: The word of SPRITE ... AT.
  example: SPRITE 3 AT x%, y%
  see: SPRITE

kw ASIDE | $FFF0 | stmt | - | core | TaskCtl | time
  syntax: ASIDE
  help: Puts the program aside (as Alt+Tab does) and shows the dock; it
  help: continues when brought back.
  example: ASIDE
  see: TASKS, STAY

kw TASKS | $FFF1 | func | ->i | core | TaskCtl | time
  syntax: TASKS
  help: How many programs are put aside.
  example: FOR i% = 1 TO TASKS : PRINT TASK$(i%) : NEXT
  see: TASK$, ASIDE

kw TASK$ | $FFF2 | func | (n)->s | core | TaskCtl | time
  syntax: TASK$(i)
  help: The name of the i-th program put aside.
  example: PRINT TASK$(1)
  see: TASKS

# ----------------------------------------------------------------------
group constants | Constants
  help: Predefined names for numbers. They are names, not keywords: a
  help: program may not assign them, and a name of its own may not take
  help: their spelling.

const CHROME | 2 | constants | theme=CHROME
  syntax: CHROME
  help: The colour of bars and buttons (2).
  example: PAPER 0, 0, 80, 2, CHROME
  see: PAPER

const SIDEBAR | 3 | constants | theme=SIDEBAR
  syntax: SIDEBAR
  help: The sidebar colour (3).
  example: PAPER 0, 2, 20, 58, SIDEBAR
  see: PAPER

const YELLOW | 6 | constants | theme=YELLOW
  syntax: YELLOW
  help: Yellow paper (6).
  example: PAPER 0, 2, 80, 1, YELLOW
  see: PAPER

const RED | 7 | constants | theme=RED
  syntax: RED
  help: Red paper (7).
  example: PAPER 10, 10, 5, 1, RED
  see: PAPER

const GREEN | 8 | constants | theme=GREEN
  syntax: GREEN
  help: Green paper (8).
  example: PAPER 10, 11, 5, 1, GREEN
  see: PAPER

const PURPLE | 9 | constants | theme=PURPLE
  syntax: PURPLE
  help: Purple paper (9).
  example: PAPER 10, 12, 5, 1, PURPLE
  see: PAPER

const ORANGE | 10 | constants | theme=ORANGE
  syntax: ORANGE
  help: Orange paper (10).
  example: PAPER 10, 13, 5, 1, ORANGE
  see: PAPER

const CYAN | 11 | constants | theme=CYAN
  syntax: CYAN
  help: Cyan paper (11), the Veranda mark's colour.
  example: PAPER 10, 14, 5, 1, CYAN
  see: PAPER

const SKY | 12 | constants | theme=SKY
  syntax: SKY
  help: Sky blue (12); palette entry 12 (PALETTE may change it).
  example: APP TILE SKY
  see: PAPER, PALETTE

const SKY2 | 13 | constants | theme=SKY2
  syntax: SKY2
  help: Light sky blue (13); palette entry 13.
  example: PAPER 0, 40, 80, 4, SKY2
  see: PAPER

const HILL | 14 | constants | theme=HILL
  syntax: HILL
  help: Palette entry 14: Sunroom's sage, the desktop's colour (before Look
  help: 3 a darker hill green). For a hill or grass, GREEN.
  example: PAPER 10, 15, 5, 1, HILL
  see: PAPER, GREEN

const DUSK | 15 | constants | theme=DUSK
  syntax: DUSK
  help: Dusk pink (15); palette entry 15.
  example: PAPER 0, 0, 80, 10, DUSK
  see: PAPER

const ARROW | 0 | constants | api=PTR_ARROW
  syntax: POINTER ARROW
  help: The arrow pointer.
  example: POINTER ARROW
  see: POINTER

const BUSY | 1 | constants | api=PTR_BUSY
  syntax: POINTER BUSY
  help: The busy pointer (animated).
  example: POINTER BUSY
  see: POINTER

const IBEAM | 2 | constants | api=PTR_IBEAM
  syntax: POINTER IBEAM
  help: The I-beam pointer, for text.
  example: POINTER IBEAM
  see: POINTER

const CROSS | 3 | constants | api=PTR_CROSS
  syntax: POINTER CROSS
  help: The cross-hair pointer.
  example: POINTER CROSS
  see: POINTER

const ERASE | 0 | constants | api=DRAW_ERASE
  syntax: LINE ..., ERASE   PLOT x, y, ERASE
  help: Draws in paper instead of ink.
  example: LINE 0, 0, 100, 100, ERASE
  see: LINE, PLOT, INK

const BOLD | $40 | constants | api=SET_BOLD
  syntax: STYLE BOLD   CARDS ..., BOLD
  help: Bold text.
  example: STYLE BOLD
  see: STYLE, CARDS

const ITALIC | $10 | constants | api=SET_ITALIC
  syntax: STYLE ITALIC
  help: Italic text.
  example: STYLE ITALIC
  see: STYLE

const UNDERLINE | $80 | constants | api=SET_UNDERLINE
  syntax: STYLE UNDERLINE
  help: Underlined text.
  example: STYLE UNDERLINE
  see: STYLE

const OUTLINE | $08 | constants | api=SET_OUTLINE
  syntax: STYLE OUTLINE
  help: Outlined text.
  example: STYLE OUTLINE
  see: STYLE

const REVERSE | $20 | constants | api=SET_REVERSE
  syntax: STYLE REVERSE   CARDS ..., REVERSE
  help: Text in paper on ink.
  example: CARDS 0, 0, " Menu ", REVERSE
  see: STYLE, CARDS

const PULSE | 0 | constants
  syntax: VOICE v, f, vol, PULSE
  help: The pulse wave (with a width).
  example: VOICE 0, 440, 63, PULSE, 32
  see: VOICE

const SAWTOOTH | 1 | constants
  syntax: VOICE v, f, vol, SAWTOOTH
  help: The sawtooth wave.
  example: VOICE 1, 220, 40, SAWTOOTH
  see: VOICE

const TRIANGLE | 2 | constants
  syntax: VOICE v, f, vol, TRIANGLE
  help: The triangle wave.
  example: VOICE 2, 330, 50, TRIANGLE
  see: VOICE

const NOISE | 3 | constants
  syntax: VOICE v, f, vol, NOISE
  help: Noise.
  example: VOICE 3, 1000, 30, NOISE
  see: VOICE

const DOCS | 1 | constants
  syntax: FOLDER$(DOCS)
  help: The user's documents folder (/DOCUMENTS).
  example: CHDIR FOLDER$(DOCS)
  see: FOLDER$

const APPS | 2 | constants
  syntax: FOLDER$(APPS)
  help: The applications folder (/VERANDA/APPS).
  example: PRINT FOLDER$(APPS)
  see: FOLDER$

const FONTS | 3 | constants
  syntax: FOLDER$(FONTS)
  help: The fonts folder (/VERANDA/FONTS).
  example: PRINT FOLDER$(FONTS)
  see: FOLDER$

const SYSTEM | 4 | constants
  syntax: FOLDER$(SYSTEM)   FONT SYSTEM
  help: The system folder (/VERANDA); with FONT, the system font.
  example: FONT SYSTEM
  see: FOLDER$, FONT

const UI | 6 | constants
  syntax: FONT UI
  help: The UI font (the menus' and dialogs').
  example: FONT UI
  see: FONT

apiconst KEY_ | constants
  syntax: KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN, KEY_F1 ... (api/veranda.api)
  help: Key codes, as KEYCODE gives them; the names and numbers are the
  help: kernel's (api/veranda.api).
  example: IF KEYCODE = KEY_ESC THEN END
  see: KEYCODE, KEY

apiconst SND_ | constants
  syntax: SOUND SND_ERROR ... (api/veranda.api)
  help: The system sounds of SOUND; the names and numbers are the kernel's
  help: (api/veranda.api).
  example: SOUND SND_WARNING
  see: SOUND
