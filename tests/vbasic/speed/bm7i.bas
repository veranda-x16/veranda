' Rugg/Feldman BM7 with integer variables
100 GOSUB 900:C0=C
200 K%=0
210 DIM M%(5)
300 K%=K%+1
400 A%=K%\2*3+4-5
410 GOSUB 820
420 FOR L%=1 TO 5
425 M%(L%)=A%
430 NEXT L%
500 IF K%<1000 THEN 300
700 GOSUB 900:PRINT "T BM7i";C-C0
710 GOTO 990
820 RETURN
900 C=PEEK(40888)+256*PEEK(40889)+65536*PEEK(40890)+16777216*PEEK(40891):RETURN
990 END
