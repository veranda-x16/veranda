' Mouse and keys
ON CLICK CALL Clicked
ON KEY CALL Typed
ON WHEEL CALL Scrolled
MOUSE LIMIT 0, 16, 639, 479
x% = 320
WAIT EVENTS
SUB Clicked
  IF MOUSEB AND 128 THEN EXIT SUB
  IF MOUSEB AND 1 THEN PLOT MOUSEX, MOUSEY
  IF MOUSEIN(0, 0, 99, 99) THEN PRINT "corner"
END SUB
SUB Typed
  SELECT CASE KEYCODE
    CASE KEY_LEFT: x% = x% - 8
    CASE KEY_RIGHT: x% = x% + 8
    CASE KEY_ESC: END
  END SELECT
  IF KEYMODS AND 2 THEN PRINT "Ctrl+"; KEY$
END SUB
SUB Scrolled
  dy% = WHEEL
  PRINT dy%
END SUB
k$ = INKEY$
