' POKE and PEEK in main RAM
POKE $7F00, 42: POKE $7F01, 255
PRINT PEEK($7F00); PEEK($7F01); PEEK($7F00) + PEEK($7F01)
POKE 32512 + 2, 7: PRINT PEEK(32514)
TRY
  POKE $A000, 1
CATCH
  PRINT "error"; ERR
END TRY
TRY
  POKE $7F00, 256
CATCH
  PRINT "error"; ERR
END TRY
POKE $7F10, $60: SYS $7F10: PRINT "back from SYS"
