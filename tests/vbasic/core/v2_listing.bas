10 REM A V2-STYLE LISTING
20 DIM A(10)
30 FOR I=1 TO 10
40 A(I)=I*I
50 NEXT I
60 S=0
70 FOR I=1 TO 10:S=S+A(I):NEXT
80 PRINT "SUM OF SQUARES";S
90 IF S>300 THEN PRINT "BIG":GOTO 110
100 PRINT "SMALL"
110 A$="COMMODORE":B$=""
120 FOR I=LEN(A$) TO 1 STEP -1:B$=B$+MID$(A$,I,1):NEXT
130 PRINT A$;" ";B$
140 GOSUB 200
150 END
200 PRINT "SUBROUTINE":RETURN
