call WRectangle       | wide | - | r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 | - | Rectangle
call WFrameRectangle  | wide | - | a:pattern:u8 r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 | - | FrameRectangle
