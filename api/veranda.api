const DESK_ACC        | 5   | file type
const APPLICATION     | 6   | file type
const ST_DA_ROOM      | $20 | GetFile option, a desk accessory (V168): DA_ROOM (2) banks left free for it after the application is put aside, else NO_BANKS (the shell then lends its desktop's banks and tries again)
const ST_LD_DATA      | $80 | GetFile option: r3 names a document, kept in dataLongName and dataFileName (its short form if longer than 16; DECISIONS V82); the application starts with r0L = the options
const APPL_DATA       | 7   | file type
const FONT            | 8   | file type
const AUTO_EXEC       | 14  | file type
const NO_BLOCKS       | 1   | error
const INV_TRACK       | 2   | error
const INSUFF_SPACE    | 3   | error: the card is full
const FULL_DIRECTORY  | 4   | error
const FILE_NOT_FOUND  | 5   | error
const BAD_BAM         | 6   | error
const UNOPENED_VLIR   | 7   | error
const INV_RECORD      | 8   | error
const OUT_OF_RECORDS  | 9   | error
const STRUCT_MISMAT   | 10  | error
const BFR_OVERFLOW    | 11  | error
const CANCEL_ERR      | 12  | error
const DEV_NOT_FOUND   | 13  | error
const INCOMPATIBLE    | 14  | error
const FILE_EXISTS     | 15  | error (Veranda)
const TOO_MANY_FILES  | 16  | error (Veranda): no free stream
const NOT_VERANDA     | 17  | error (Veranda): not a Veranda application (no VRND in its info block)
const TOO_NEW         | 18  | error (Veranda): the application needs a newer API level
const NO_BANKS        | 19  | error (Veranda): not enough free RAM banks
const DOS_ERROR       | 20  | error (Veranda): CMDR-DOS reported an error (the status in dosStatus)
const KEYPRESS_BIT    | 7   | pressFlag
const INPUT_BIT       | 6   | pressFlag
const MOUSE_BIT       | 5   | pressFlag

# ---------------------------------------------------------------- classic calls (GEOS positions)
call InterruptMain    | classic | $C100 | - | - | the interrupt's GEOS part (for applications that take over the interrupt)
call InitProcesses    | classic | $C103 | r0:table:ptr a:count:u8 | - | install a process table
call RestartProcess   | classic | $C106 | x:process:u8 | - | restart a process's timer
call EnableProcess    | classic | $C109 | x:process:u8 | - | make a process run at the next main loop pass
call BlockProcess     | classic | $C10C | x:process:u8 | - | stop a process's events
call UnblockProcess   | classic | $C10F | x:process:u8 | - | allow a process's events again
call FreezeProcess    | classic | $C112 | x:process:u8 | - | stop a process's timer
call UnfreezeProcess  | classic | $C115 | x:process:u8 | - | restart a process's timer where it stopped
call HorizontalLine   | classic | $C118 | a:pattern:u8 r3:x1:u16 r4:x2:u16 r11L:y:u8 | - | horizontal line with a pattern byte
call InvertLine       | classic | $C11B | r3:x1:u16 r4:x2:u16 r11L:y:u8 | - | invert a horizontal line
call RecoverLine      | classic | $C11E | r3:x1:u16 r4:x2:u16 r11L:y:u8 | - | copy a horizontal line from the back screen
call VerticalLine     | classic | $C121 | a:pattern:u8 r3L:y1:u8 r3H:y2:u8 r4:x:u16 | - | vertical line with a pattern byte
call Rectangle        | classic | $C124 | r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | - | fill a rectangle with the current pattern
call FrameRectangle   | classic | $C127 | a:pattern:u8 r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | - | rectangle outline with a pattern byte
call InvertRectangle  | classic | $C12A | r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | - | invert a rectangle
call RecoverRectangle | classic | $C12D | r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | - | copy a rectangle from the back screen
call DrawLine         | classic | $C130 | n:recover:flag c:ink:flag r3:x1:u16 r11L:y1:u8 r4:x2:u16 r11H:y2:u8 | - | line: N set recover, else C set ink, C clear paper [noc]
call DrawPoint        | classic | $C133 | n:recover:flag c:ink:flag r3:x:u16 r11L:y:u8 | - | point: flags as DrawLine [noc]
call GraphicsString   | classic | $C136 | r0:string:ptr | - | interpret a graphics string
call SetPattern       | classic | $C139 | a:pattern:u8 | - | select fill pattern 0-33
call GetScanLine      | drop    | $C13C | - | - | the screen is in VRAM: use ReadRow/WriteRow
call TestPoint        | classic | $C13F | r3:x:u16 r11L:y:u8 | c:set:flag | c = the pixel's value
call BitmapUp         | classic | $C142 | r0:bitmap:ptr r1L:x:u8 r1H:y:u8 r2L:width:u8 r2H:height:u8 | - | draw a compacted bitmap; x and width in cards (8 pixels)
call PutChar          | classic | $C145 | a:char:u8 r11:x:u16 r1H:y:u8 | - | draw a character; r11 advances
call PutString        | classic | $C148 | r0:string:ptr r11:x:u16 r1H:y:u8 | - | draw a string with style codes
call UseSystemFont    | classic | $C14B | - | - | select the system font
call StartMouseMode   | classic | $C14E | c:place:flag r11:x:u16 y:y:u8 | - | pointer on; with C set placed at r11, y [noc]
call DoMenu           | classic | $C151 | r0:menu:ptr a:item:u8 | - | draw a menu and start menu handling
call RecoverMenu      | classic | $C154 | - | - | remove the last menu level
call RecoverAllMenus  | classic | $C157 | - | - | remove all menu levels
call DoIcons          | classic | $C15A | r0:icons:ptr | - | draw an icon table and start icon handling
call DShiftLeft       | classic | $C15D | x:reg:u8 y:count:u8 | - | shift the word at zero page x left y times [noc]
call BBMult           | classic | $C160 | x:reg:u8 y:reg2:u8 | - | byte * byte [noc]
call BMult            | classic | $C163 | x:reg:u8 y:reg2:u8 | - | word * byte [noc]
call DMult            | classic | $C166 | x:reg:u8 y:reg2:u8 | - | word * word [noc]
call Ddiv             | classic | $C169 | x:reg:u8 y:reg2:u8 | - | word / word, remainder in r8 [noc]
call DSdiv            | classic | $C16C | x:reg:u8 y:reg2:u8 | - | signed word / word [noc]
call Dabs             | classic | $C16F | x:reg:u8 | - | absolute value of a word [noc]
call Dnegate          | classic | $C172 | x:reg:u8 | - | negate a word [noc]
call Ddec             | classic | $C175 | x:reg:u8 | - | decrement a word, Z set when it reaches 0 [noc]
call ClearRam         | classic | $C178 | r0:count:u16 r1:addr:ptr | - | clear memory
call FillRam          | classic | $C17B | r0:count:u16 r1:addr:ptr r2L:value:u8 | - | fill memory
call MoveData         | classic | $C17E | r0:source:ptr r1:dest:ptr r2:count:u16 | - | copy memory (overlapping is fine)
call InitRam          | classic | $C181 | r0:table:ptr | - | store bytes from an InitRam table
call PutDecimal       | classic | $C184 | a:format:u8 r0:value:u16 r11:x:u16 r1H:y:u8 | - | draw a number
call GetRandom        | classic | $C187 | - | - | update random
call MouseUp          | classic | $C18A | - | - | pointer on
call MouseOff         | classic | $C18D | - | - | pointer off
call DoPreviousMenu   | classic | $C190 | - | - | back one menu level
call ReDoMenu         | classic | $C193 | - | - | redraw the menu
call GetSerialNumber  | classic | $C196 | - | r0:serial:u16 | a constant number on Veranda
call Sleep            | classic | $C199 | r0:frames:u16 | - | continue after r0 frames (returns to the caller's caller)
call ClearMouseMode   | classic | $C19C | - | - | pointer and menu handling off
call i_Rectangle      | classic | $C19F | inline | - | Rectangle with inline parameters
call i_FrameRectangle | classic | $C1A2 | inline | - | FrameRectangle with inline parameters
call i_RecoverRectangle | classic | $C1A5 | inline | - | RecoverRectangle with inline parameters
call i_GraphicsString | classic | $C1A8 | inline | - | GraphicsString with an inline string
call i_BitmapUp       | classic | $C1AB | inline | - | BitmapUp with inline parameters
call i_PutString      | classic | $C1AE | inline | - | PutString with inline parameters
call GetRealSize      | classic | $C1B1 | a:char:u8 x:mode:u8 | y:width:u8 | size of a character in a style; x height, a baseline
call i_FillRam        | classic | $C1B4 | inline | - | FillRam with inline parameters
call i_MoveData       | classic | $C1B7 | inline | - | MoveData with inline parameters
call GetString        | classic | $C1BA | r0:buffer:ptr r2L:max:u8 r11:x:u16 r1H:y:u8 r1L:flags:u8 r4:fault:ptr | - | text input
call GotoFirstMenu    | classic | $C1BD | - | - | back to the main menu
call InitTextPrompt   | classic | $C1C0 | a:height:u8 | - | text cursor of this height
call MainLoop         | classic | $C1C3 | - | - | the main loop [noc] [noreturn]
call DrawSprite       | classic | $C1C6 | r3L:sprite:u8 r4:picture:ptr | - | sprite picture (GEOS 24x21, 1 bpp)
call GetCharWidth     | classic | $C1C9 | a:char:u8 | a:width:u8 | width of a character in the current font
call LoadCharSet      | classic | $C1CC | r0:font:ptr | - | select a font
call PosSprite        | classic | $C1CF | r3L:sprite:u8 r4:x:u16 r5L:y:u8 | - | sprite position
call EnablSprite      | classic | $C1D2 | r3L:sprite:u8 | - | sprite on
call DisablSprite     | classic | $C1D5 | r3L:sprite:u8 | - | sprite off
call CallRoutine      | classic | $C1D8 | a:low:u8 x:high:u8 | - | call a routine (nothing if 0) [noc]
call CalcBlksFree     | classic | $C1DB | - | r4:free:u16 | free space in blocks of 254 bytes (capped at 65535); r3 the total
call ChkDkGEOS        | drop    | $C1DE | - | - | disk images only
call NewDisk          | drop    | $C1E1 | - | - | disk images only
call GetBlock         | drop    | $C1E4 | - | - | block access: use streams
call PutBlock         | drop    | $C1E7 | - | - | block access: use streams
call SetGEOSDisk      | drop    | $C1EA | - | - | disk images only
call SaveFile         | classic | $C1ED | r9:header:ptr r10L:page:u8 | x:error:u8 | write a GEOS file described by an info block
call SetGDirEntry     | drop    | $C1F0 | - | - | directory blocks: not on FAT32
call BldGDirEntry     | drop    | $C1F3 | - | - | directory blocks: not on FAT32
call GetFreeDirBlk    | drop    | $C1F6 | - | - | directory blocks: not on FAT32
call WriteFile        | drop    | $C1F9 | - | - | block chains: use streams
call BlkAlloc         | drop    | $C1FC | - | - | block allocation: not on FAT32
call ReadFile         | drop    | $C1FF | - | - | block chains: use streams
call SmallPutChar     | classic | $C202 | a:char:u8 r11:x:u16 r1H:y:u8 | - | PutChar without the style codes
call FollowChain      | drop    | $C205 | - | - | block chains: not on FAT32
call GetFile          | classic | $C208 | r6:name:ptr r0L:options:u8 r2:disk:ptr r3:document:ptr r7:load:ptr | x:error:u8 | load and start an application or desk accessory, or load a file
call FindFile         | classic | $C20B | r6:name:ptr | x:error:u8 | find a file; its entry in dirEntryBuf
call CRC              | classic | $C20E | r0:data:ptr r1:count:u16 | r2:crc:u16 | CRC-16 of memory
call LdFile           | classic | $C211 | r9:entry:ptr | x:error:u8 | load a file from its directory entry
call EnterTurbo       | drop    | $C214 | - | - | no disk turbo
call LdDeskAcc        | drop    | $C217 | - | - | use GetFile on the desk accessory
call ReadBlock        | drop    | $C21A | - | - | block access: use streams
call LdApplic         | classic | $C21D | r9:entry:ptr r0L:options:u8 | x:error:u8 | load and start an application from its directory entry
call WriteBlock       | drop    | $C220 | - | - | block access: use streams
call VerWriteBlock    | drop    | $C223 | - | - | block access: use streams
call FreeFile         | drop    | $C226 | - | - | block chains: use DeleteFile
call GetFHdrInfo      | classic | $C229 | r9:entry:ptr | x:error:u8 | read a file's info block into fileHeader
call EnterDeskTop     | classic | $C22C | - | - | quit to the desktop: DESKTOP.cvt if there is one (another desktop the user chose), else the shell, SHELL.cvt; in /VERANDA, else the root [noreturn]
call StartAppl        | classic | $C22F | r7:start:ptr | - | start the application in memory [noreturn] [noc]
call ExitTurbo        | drop    | $C232 | - | - | no disk turbo
call PurgeTurbo       | drop    | $C235 | - | - | no disk turbo
call DeleteFile       | classic | $C238 | r0:name:ptr | x:error:u8 | delete a file
call FindFTypes       | classic | $C23B | r6:buffer:ptr r7L:type:u8 r7H:max:u8 r10:class:ptr | r7H:left:u8 | names of the files of a type (and class)
call RstrAppl         | classic | $C23E | - | - | a desk accessory ends: the application that opened it comes back as it was, returning from its GetFile [noreturn]
call ToBASIC          | classic | $C241 | r0:command:ptr | - | quit to BASIC (r0: a command for BASIC or 0): Veranda gone, its banks and the resident core freed; with r1 = TOBASIC_KEEP Veranda stays in memory (DECISIONS V64, the RBOOT model: the resident core, the kernel banks, their copy and bank RB above MEMTOP, $8800 and a lowered bank count; SYS 40608 or RBOOT comes back to the desktop in the shell's folder) [noreturn]
const TOBASIC_KEEP  | $4B56 | ToBASIC: r1 = this keeps Veranda in memory (V64)
call FastDelFile      | drop    | $C244 | - | - | block chains: use DeleteFile
call GetDirHead       | drop    | $C247 | - | - | disk images only
call PutDirHead       | drop    | $C24A | - | - | disk images only
call NxtBlkAlloc      | drop    | $C24D | - | - | block allocation: not on FAT32
call ImprintRectangle | classic | $C250 | r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | - | copy a rectangle to the back screen
call i_ImprintRectangle | classic | $C253 | inline | - | ImprintRectangle with inline parameters
call DoDlgBox         | classic | $C256 | r0:box:ptr | r0L:result:u8 | dialog box
call RenameFile       | classic | $C259 | r6:old:ptr r0:new:ptr | x:error:u8 | rename a file
call InitForIO        | classic | $C25C | - | - | nothing on Veranda (kept for sources)
call DoneWithIO       | classic | $C25F | - | - | nothing on Veranda (kept for sources)
call DShiftRight      | classic | $C262 | x:reg:u8 y:count:u8 | - | shift the word at zero page x right y times [noc]
call CopyString       | classic | $C265 | x:from:u8 y:to:u8 | - | copy a 0-terminated string (zero page pointers) [noc]
call CopyFString      | classic | $C268 | x:from:u8 y:to:u8 a:count:u8 | - | copy a bytes (zero page pointers) [noc]
call CmpString        | classic | $C26B | x:a:u8 y:b:u8 | - | compare 0-terminated strings; Z set if equal [noc]
call CmpFString       | classic | $C26E | x:a:u8 y:b:u8 a:count:u8 | - | compare a bytes [noc]
call FirstInit        | classic | $C271 | - | - | reset the system variables
call OpenRecordFile   | classic | $C274 | r0:name:ptr | x:error:u8 | open a record file (held in banked RAM)
call CloseRecordFile  | classic | $C277 | - | x:error:u8 | close it, writing it back if changed
call NextRecord       | classic | $C27A | - | x:error:u8 | next record
call PreviousRecord   | classic | $C27D | - | x:error:u8 | previous record
call PointRecord      | classic | $C280 | a:record:u8 | x:error:u8 y:data:u8 | select a record; y = $FF if it holds data, 0 if it is empty (GEOS: its track)
call DeleteRecord     | classic | $C283 | - | x:error:u8 | delete the current record
call InsertRecord     | classic | $C286 | - | x:error:u8 | insert an empty record before the current one
call AppendRecord     | classic | $C289 | - | x:error:u8 | add an empty record after the current one
call ReadRecord       | classic | $C28C | r7:dest:ptr r2:max:u16 | x:error:u8 | read the current record; r7 moves past the data (r7 at $A000-$BFFF: in the caller's bank)
call WriteRecord      | classic | $C28F | r7:source:ptr r2:count:u16 | x:error:u8 | replace the current record (r7 at $A000-$BFFF: in the caller's bank)
call SetNextFree      | drop    | $C292 | - | - | block allocation: not on FAT32
call UpdateRecordFile | classic | $C295 | - | x:error:u8 | write the record file back now
call GetPtrCurDkNm    | classic | $C298 | x:reg:u8 | - | zero page x = pointer to the volume name [noc]
call PromptOn         | classic | $C29B | - | - | text cursor on
call PromptOff        | classic | $C29E | - | - | text cursor off
call OpenDisk         | classic | $C2A1 | - | x:error:u8 | read the current directory again
call DoInlineReturn   | classic | $C2A4 | a:count:u8 | - | return from an inline call [noc]
call GetNextChar      | classic | $C2A7 | - | a:char:u8 | the next key, 0 if none
call BitmapClip       | classic | $C2AA | r0:bitmap:ptr r1L:x:u8 r1H:y:u8 r2L:width:u8 r2H:height:u8 r11L:skipleft:u8 r11H:skipright:u8 r12:skiptop:u16 | - | draw part of a bitmap
call FindBAMBit       | drop    | $C2AD | - | - | disk images only
call SetDevice        | classic | $C2B0 | a:device:u8 | x:error:u8 | only 8 (the SD card) exists
call IsMseInRegion    | classic | $C2B3 | r2L:top:u8 r2H:bottom:u8 r3:left:u16 r4:right:u16 | a:inside:u8 | a = $FF if the pointer is inside
call ReadByte         | drop    | $C2B6 | - | - | block chains: use FRead
call FreeBlock        | drop    | $C2B9 | - | - | disk images only
call ChangeDiskDevice | drop    | $C2BC | - | - | disk images only
call RstrFrmDialogue  | classic | $C2BF | - | - | close the dialog box (from inside it)
call Panic            | classic | $C2C2 | - | - | the panic box (as a BRK): the caller's address and the application's name; OK goes back to the shell with the kernel banks restored from their copy [noreturn]
call BitOtherClip     | classic | $C2C5 | r0:bitmap:ptr r1L:x:u8 r1H:y:u8 r2L:width:u8 r2H:height:u8 r11L:skipleft:u8 r11H:skipright:u8 r12:skiptop:u16 r13:app:ptr r14:sync:ptr | - | BitmapClip with the data from a routine
call StashRAM         | drop    | $C2C8 | - | - | REU: use BankCopy
call FetchRAM         | drop    | $C2CB | - | - | REU: use BankCopy
call SwapRAM          | drop    | $C2CE | - | - | REU: use BankCopy
call VerifyRAM        | drop    | $C2D1 | - | - | REU: use BankCopy
call DoRAMOp          | drop    | $C2D4 | - | - | REU: use BankCopy
call TempHideMouse    | classic | $C2D7 | - | - | hide the pointer until it moves (GEOS 128)
call SetMsePic        | drop    | $C2DA | - | - | GEOS 128: use DrawSprite on sprite 0
call SetNewMode       | drop    | $C2DD | - | - | GEOS 128: use SetVideoMode
call NormalizeX       | drop    | $C2E0 | - | - | GEOS 128: not needed
call MoveBData        | drop    | $C2E3 | - | - | GEOS 128 banks: use BankCopy
call SwapBData        | drop    | $C2E6 | - | - | GEOS 128 banks: use BankCopy
call VerifyBData      | drop    | $C2E9 | - | - | GEOS 128 banks: use BankCopy
call DoBOp            | drop    | $C2EC | - | - | GEOS 128 banks: use BankCopy
call AccessCache      | drop    | $C2EF | - | - | GEOS 128: not needed
call HideOnlyMouse    | classic | $C2F2 | - | - | hide the pointer (GEOS 128)
call SetColorMode     | drop    | $C2F5 | - | - | GEOS 128 VDC colour: use SetColors
call ColorCard        | drop    | $C2F8 | - | - | GEOS 128 VDC colour
call ColorRectangle   | drop    | $C2FB | - | - | GEOS 128 VDC colour

