call WPosSprite       | wide | - | r3L:sprite:u8 r4:x:u16 r11:y:u16 | - | PosSprite
call WIsMseInRegion   | wide | - | r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 | a:inside:u8 | IsMseInRegion
call WStartMouseMode  | wide | - | a:place:u8 r11:x:u16 r12:y:u16 | - | StartMouseMode; a <> 0: place the pointer
call WSetMouseRegion  | wide | - | r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 | - | the pointer's region
call WSetWindow       | wide | - | r11:top:u16 r12:bottom:u16 | - | the clip window's top and bottom

# ---------------------------------------------------------------- new calls
call GetVersion       | new | - | - | a:level:u8 | API level (API_LEVEL); x.y the version
call SetVideoMode     | new | - | a:mode:u8 | x:error:u8 | MODE_640x480, MODE_640x240 or MODE_320x240; clears both screens
call SetColors        | new | - | r0:paper:u16 r1:ink:u16 | - | paper and ink, $0RGB each (palette entries 0 and 1); $FFFF leaves one as it is (the ink alone: r0 = $FFFF); an application starts in white paper and black ink
call CopyRect         | new | - | r3L:x:u8 r3H:width:u8 r11:y:u16 r12:height:u16 r4L:tox:u8 r13:toy:u16 | - | copy a screen area (x and width in cards) on the screens dispBufferOn selects; overlapping is fine
call ScrollRect       | new | - | r3L:x:u8 r3H:width:u8 r11:top:u16 r12:bottom:u16 r13:dy:i16 a:pattern:u8 | - | move an area up (dy < 0) or down by dy lines; the uncovered lines get the pattern
call ReadRow          | new | - | r0:buffer:ptr r3L:x:u8 r3H:count:u8 r11:y:u16 | - | bytes of a screen row (dispBufferOn bit 6: the back screen) into memory
call WriteRow         | new | - | r0:buffer:ptr r3L:x:u8 r3H:count:u8 r11:y:u16 | - | bytes from memory into a screen row (the screens dispBufferOn selects)
call FOpen            | new | - | r0:name:ptr a:mode:u8 | a:handle:u8 | open a file: a = 'r', 'w' (create or replace) or 'm' (read and write); x = error (TOO_MANY_FILES: three streams open already, V68)
call FRead            | new | - | a:handle:u8 r0:buffer:ptr r1:count:u16 | r1:done:u16 | read up to r1 bytes; x = error
call FWrite           | new | - | a:handle:u8 r0:buffer:ptr r1:count:u16 | x:error:u8 | write r1 bytes
call FSeek            | new | - | a:handle:u8 r0:poslow:u16 r1:poshigh:u16 | x:error:u8 | move to a byte position
call FClose           | new | - | a:handle:u8 | x:error:u8 | close a file
call DirOpen          | new | - | r0:pattern:ptr | x:error:u8 | start reading the current directory (pattern "*" for all); a pattern that starts with "=" is CMDR-DOS's listing option ("=L": the long listing, sizes in bytes and dates), sent as "$=L" ..., and DirNext then gives the lines raw (DECISIONS V70)
call DirNext          | new | - | r0:entry:ptr | x:error:u8 | the next entry: name (0-terminated), size, type; x <> 0 at the end; after DirOpen "=..." the next line raw: +0 'R', +1 its number (word), +3 its text 0-terminated (at most 122 bytes: a 125-byte entry), the header line first and the footer (the free space) last (DECISIONS V70)
call ChDir            | new | - | r0:path:ptr | x:error:u8 | change the current directory
call MkDir            | new | - | r0:path:ptr | x:error:u8 | make a directory
call FDelete          | new | - | r0:name:ptr | x:error:u8 | delete any file
call FRename          | new | - | r0:old:ptr r1:new:ptr | x:error:u8 | rename any file
call BankAlloc        | new | - | a:count:u8 | a:first:u8 | allocate RAM banks for the application; x = error
call BankFree         | new | - | a:first:u8 | - | free them
call BankCopy         | new | - | r0:source:ptr r1:dest:ptr r2:count:u16 r3L:frombank:u8 r3H:tobank:u8 | - | copy memory between banks (bank 0: below $A000 as it is)
call LoadOverlay      | new | - | a:record:u8 r7:dest:ptr | x:error:u8 | copy overlay record a of the running application (kept in RAM banks) to r7 (at $A000-$BFFF: in the caller's bank); r7 = 0: nothing copied, r1L (and a) the RAM bank that holds the record and r0 its address ($A000 with overlays = banked: run it there; API 2)
call GetMouse         | new | - | - | a:buttons:u8 | mouseButtons, and the wheel movement in x (cleared)
call GetKeyMods       | new | - | - | a:mods:u8 | keyMods
call LogText          | new | - | r0:text:ptr | - | write a line to the emulator's console (nothing on hardware)
call RecordInfo       | new | - | a:write:u8 r0:buffer:ptr | x:error:u8 | the open record file's info block (256 bytes, as fileHeader): to r0 (a = 0) or from r0 (a <> 0; written back with the file)
call ExportRect       | new | - | r0:name:ptr r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 a:screen:u8 | x:error:u8 | write a screen area to a file (any name) as a BMP picture, rows bottom-up, padded to 4 bytes; a bit 0: 0 the foreground, 1 the back screen; bit 7 clear: 1 bpp (1 = ink, the palette's paper and ink); bit 7 set, with the colour map shown: 4 bpp in palette entries 0-15, each paper pixel in its card's colour, ink entry 1 (in tile mode, V101: 8 bpp, all 256 entries, each paper pixel its tile's); clipped to the screen (INCOMPATIBLE: nothing left)
call ColorRect        | new | - | r3L:x:u8 r3H:width:u8 r11L:y:u8 r11H:height:u8 a:colour:u8 | - | the paper colour (palette entry 0-15; 0 the normal paper) of an area of cards (8 x 8 pixels; clipped to the screen); the first call shows the colour map (every card 0), a = $FF clears and hides it (SetVideoMode does too), a = COLOR_BUF ($FE) gives each card its own colour from r0 (a byte a card, its low nibble; r3H bytes a row, the rows one after the other: a picture, DECISIONS V78; not in tile mode), a = COLOR_CANVAS ($FC, V166) the canvas (COLOR_CANVAS; normal colours do nothing while it is on), a = COLOR_TILES ($FD) shows the map in tile mode (V101: layer 0 in 4 bpp 8 x 8 tiles at VRAM_TILES, $13000-$16BFF, which the program fills with its tiles and palette rows 2-13; colour c is solid tile c in palette row 0; menus and dialog boxes then recover from the back screen; hiding the map then puts palette entries 32-255 back from VRAM_TILEPAL, $12C00, where the program keeps its rows first); the ink stays palette entry 1 (SetColors); menus, dialog boxes and desk accessories show over the normal paper (the cards under them come back after), and a card under one gets its colour when it is uncovered
const COLOR_BUF     | $FE   | ColorRect: each card's colour from the buffer at r0 (V78)
const COLOR_TILES   | $FD   | ColorRect: the colour map on as 4 bpp tiles at VRAM_TILES, cleared (the shell's desktop picture, V101; a program's through the SDK's vrpic.h, V105)
const COLOR_CANVAS  | $FC   | ColorRect: the canvas (V166): in the 320 x 240 mode an 8 bpp picture on layer 0 at VR_CANVAS ($02800-$153FF) under the 1 bpp screen, x = 0 on (r0 the program's cover routine: a = 0 cover, 1 uncover, the cards at r1: x, width, y, height), x = 1 its VRAM and the save-under's free part zeroed (asideVector: packs small); the SDK's vrcanvas.h
call GetCardColor     | new | - | r3L:x:u8 r11L:y:u8 | a:colour:u8 | a card's paper colour from the colour map (0 when it is hidden; in tile mode 0 for a card of the program's own tiles)
call FSize            | new | - | a:handle:u8 | r0:sizelow:u16 r1:sizehigh:u16 r2:poslow:u16 r3:poshigh:u16 x:error:u8 | an open file's size (r0 low word, r1 high word) and position (r2, r3), from the DOS's tell command (API 2)
call PutCards         | new | - | r0:text:ptr r1:font:ptr r3L:x:u8 r3H:count:u8 r11:y:u16 a:flags:u8 | - | text in 8 x 8 cells: r3H characters (or up to a 0) at card column r3L, top row r11; glyph c is the 8 bytes at r1 + 8 * c (rows top first); a bit 0 reverse, bit 1 bold; opaque; the screens dispBufferOn selects, the clip window's rows; r0 and r1 below $A000 (API 2)
call PrintOpen        | new | - | r0:name:ptr a:flags:u8 | x:error:u8 r1:rowbytes:u16 r2:rows:u16 r3:width:u16 | start a document printed to a PDF file (any name; it is replaced): a = PRINT_LETTER for US Letter (else A4) + PRINT_300DPI for 300 dpi (else 150); a page is a 1 bpp bitmap of r3 dots across (r1 bytes a row, bit 7 the left dot, 1 = ink) and r2 rows; one document at a time (INCOMPATIBLE); r4-r15 changed (API 2)
call PrintBand        | new | - | r0:buffer:ptr a:rows:u8 | x:error:u8 | a rows of the page from r0 (r1 of PrintOpen bytes each, top first; at $A000-$BFFF in the caller's RAM bank, on into the next bank at $C000), coded as they come; a page is full after its last row, and the next row starts a new page; BFR_OVERFLOW: too many pages (90 a document); r0-r15 changed (API 2)
call PrintPage        | new | - | - | x:error:u8 | the current page ends: its rows not sent are white (with none sent: a blank page); r0-r15 changed (API 2)
call PrintClose       | new | - | - | x:error:u8 | the document ends (a page being sent ends as with PrintPage) and the file is closed; r0-r15 changed (API 2)
call PrintRect        | new | - | r3:left:u16 r11:top:u16 r4:right:u16 r12:bottom:u16 a:flags:u8 | x:error:u8 | a screen area (clipped to the screen) printed as a page of its own of the open document, scaled at printer resolution: a bit 0 the back screen (else the foreground), PRINT_FIT the largest size inside a quarter-inch margin (else 80 screen pixels an inch, as GEOS printed, clipped at the margin), PRINT_COLOR the ink in its colour (palette entry 1) and, with the colour map shown, the paper colours; centred across, at the top; INCOMPATIBLE: no document, or nothing left; r0-r15 changed (API 2)
call SetClock         | new | - | r0L:year:u8 r0H:month:u8 r1L:day:u8 r1H:hour:u8 r2L:minutes:u8 r2H:seconds:u8 r3H:weekday:u8 | - | set the date and time: the X16's battery-backed clock (the ROM's clock_set_date_time: r0L years since 1900, r0H month 1-12, r1L day, r1H hour 0-23, r2L minutes, r2H seconds, r3H day of the week 1-7) and Veranda's year ... seconds at once (API 2)
const PRINT_LETTER  | $01   | PrintOpen: US Letter (else A4)
const PRINT_300DPI  | $02   | PrintOpen: 300 dpi (else 150)
const PRINT_BACK    | $01   | PrintRect: the back screen
const PRINT_FIT     | $02   | PrintRect: fit to the page
const PRINT_COLOR   | $80   | PrintRect: the ink and paper colours
call DefMouse         | new | - | - | - | the system's handling of a button change (the menus, the icons, else otherPressVec), for a program's own mouseVector to pass a change on to (GEOS's mouseVector holds its handling; Veranda's is 0) (API 2)
call RmDir            | new | - | r0:path:ptr | x:error:u8 | remove an empty directory (API 2)
call SetPointer       | new | - | a:shape:u8 | a:old:u8 | the pointer's shape (sprite 0): PTR_ARROW, PTR_BUSY (animated), PTR_IBEAM or PTR_CROSS (their hot spot in the middle); returns the shape before; the arrow while a menu level or a dialog box is open; Veranda shows PTR_BUSY by itself while the main loop has not run for a third of a second (a file load, the loader, a long call); a program that draws sprite 0 itself (DrawSprite) gets its own picture back with PTR_ARROW + PTR_OWN (API 2)
call Beep             | new | - | - | - | the system beep: a short two-note chime on VERA's PSG voice 15, played by the interrupt (about a quarter of a second; the call returns at once); dialog boxes use it for errors; PlaySound(SND_ERROR) since API 4 (silent with the settings' sounds off) (API 2)
const PTR_ARROW     | 0     | SetPointer: the arrow
const PTR_BUSY      | 1     | SetPointer: busy (animated)
const PTR_IBEAM     | 2     | SetPointer: the I-beam (text)
const PTR_CROSS     | 3     | SetPointer: the crosshair (drawing)
const PTR_OWN       | $80   | SetPointer: with PTR_ARROW, sprite 0's own picture (DrawSprite on sprite 0)
call SysPrefs         | new | - | a:op:u8 r0:buffer:ptr | x:error:u8 | the system's settings and alarms (DECISIONS V56; r0 below $A000): a = PREFS_GET the settings block (PREFS_SIZE bytes: paper, ink, blankDelay words; the flags PREFS_NOSOUND, PREFS_MENUTICK and the pointer's speed 0-2 in bits 0-1; the video mode of programs that keep theirs, $FF none; the time zone in quarter hours; 6 bytes the control panel's; byte PREFS_VOLUME: PREFS_VOLSET + 63 - the sounds' volume, API 4) to r0, PREFS_SET from r0 (blankDelay, the sounds and the speed at once, the colours and the mode from the next program's start), ALARMS_GET the alarm table (ALARM_MAX entries of ALARM_SIZE: year 0-99, month, day, hour, minute, the state ALARM_ARMED or ALARM_DONE, a text of up to 24 characters and its 0) to r0, ALARMS_SET from r0 (entries already due are marked done); a due alarm beeps and shows a box over any program. Read at start-up from "Veranda Prefs" and "Veranda Alarms" in the system folder (API 2); DESK_GET the desktop's path (DESK_SIZE bytes, curDirName's layout; 0: not set) to r0, DESK_SET from r0: the shell's own folder, kept across programs and crashes, which applications leave alone (DECISIONS V63; API 3); r0-r3 kept
const PREFS_GET     | 0     | SysPrefs: the settings to r0
const PREFS_SET     | 1     | SysPrefs: the settings from r0
const ALARMS_GET    | 2     | SysPrefs: the alarm table to r0
const ALARMS_SET    | 3     | SysPrefs: the alarm table from r0
const DESK_GET      | 4     | SysPrefs: the desktop's path to r0 (API 3)
const DESK_SET      | 5     | SysPrefs: the desktop's path from r0 (API 3)
const DESK_SIZE     | 64    | SysPrefs: the desktop's path's size (curDirName's)
const PREFS_SIZE    | 16    | SysPrefs: the settings block's size
const PREFS_NOBEEP  | $80   | the settings' flags (byte 6): Beep is silent (PREFS_NOSOUND's old name)
const PREFS_NOSOUND | $80   | the settings' flags (byte 6): the sounds off (PlaySound and Beep silent, but the alarm) (API 4)
const PREFS_MENUTICK | $40  | the settings' flags (byte 6): a soft tick when a menu opens or an item is chosen (API 4)
const PREFS_POLISH  | $04   | the settings' flags (byte 6): the keyboard is Polish (programmers): right Alt + a c e l n o s x z (Shift: capitals) gives the ISO-8859-16 letters (DECISIONS V142; API 7)
const PREFS_SWITCH  | $30   | the settings' flags (byte 6): how the switcher puts programs aside (DECISIONS V145): 0 by the machine (Roomy below 2 MB, Fast from 2 MB), PREFS_FAST or PREFS_ROOMY (API 7)
const PREFS_FAST    | $10   | the settings' flags (byte 6), PREFS_SWITCH: Fast: programs aside stay in RAM banks, so the switcher keeps banks free (a program that holds too many is asked to quit instead) (API 7)
const PREFS_ROOMY   | $20   | the settings' flags (byte 6), PREFS_SWITCH: Roomy: a program that does not fit in the free RAM banks is put aside onto the card (/VERANDA/.SYSTEM/TASKS), so programs may use all banks but two (API 7)
const PREFS_VOLUME  | 15    | SysPrefs: the settings' byte of the sounds' volume, PREFS_VOLSET + 63 - the volume (0-63, in VERA's 0.5 dB steps); without PREFS_VOLSET (a file saved before DECISIONS V72) full volume (API 4)
const PREFS_VOLSET  | $80   | the settings' byte PREFS_VOLUME: bit 7, the volume is stored (DECISIONS V72; without it full volume) (API 4)
const ALARM_SIZE    | 32    | SysPrefs: an alarm entry's size
const ALARM_MAX     | 8     | SysPrefs: the entries in the alarm table
const ALARM_ARMED   | 1     | an alarm entry's state (byte 5): waiting
const ALARM_DONE    | 2     | an alarm entry's state: shown
call LoadFont         | new | - | r0:name:ptr a:size:u8 | a:handle:u8 | a font into RAM banks, once for every program: the record of that point size of the GEOS font file name (the FAT file name.cvt, up to 31 characters) in the fonts folder /VERANDA/FONTS, else in the current directory; "System" (9) and "Veranda UI" (12) are built in; returns its handle (0 the system font, FONT_UI, 2-16) for UseFont, or FONT_NONE and x the error (FILE_NOT_FOUND: no such file or size; INCOMPATIBLE: not a font; STRUCT_MISMAT; NO_BANKS; BFR_OVERFLOW: 16 fonts); r0-r3 kept (API 3)
call UseFont          | new | - | a:handle:u8 | x:error:u8 | select a font LoadFont gave (0 the system font, as UseSystemFont); text then draws with it at the speed of a font in the program's memory less the cost of a row copy (DECISIONS V62); curIndexTable and cardDataPntr are then not addresses in the program's memory: use GetCharWidth; x = INV_RECORD if there is no such font; r0-r3 kept (API 3)
call FontInfo         | new | - | a:handle:u8 r0:name:ptr | a:size:u8 | a font's point size; r1L its height, r1H its baseline; its name to r0 (FONT_NAME_LEN bytes; r0 = 0: not wanted); x = INV_RECORD if there is no such font (API 3)
call FontList         | new | - | r0:buffer:ptr a:max:u8 | a:count:u8 | the installed fonts: at most a names of FONT_NAME_LEN bytes at r0 ("System", "Veranda UI", then the fonts folder's in alphabetical order); r0-r3 kept (API 3)
call FontSizes        | new | - | r0:name:ptr r1:buffer:ptr | a:count:u8 | the point sizes a font has (FontList's names), in increasing order at r1 (up to 62 bytes); x = the error (a = 0); r0-r3 kept (API 3)
call FontFlush        | new | - | r0:name:ptr | - | forget the sizes of a font that LoadFont loaded (their RAM banks freed; the current font stays), so that the next LoadFont reads its file again: after a program wrote it (the Font Editor); r0-r3 kept (API 3)
const FONT_UI       | 1     | LoadFont, UseFont: the built-in Veranda UI font (12 points)
const FONT_NONE     | $FF   | LoadFont: no font (x the error)
const LOOK_BAR      | $80   | uiLook: the Veranda look of menus (DECISIONS V74)
const LOOK_HILITE   | $0F   | uiLook: the selection's palette entry (0: inverted, no colours)
const FONT_NAME_LEN | 32    | FontList, FontInfo: a name's bytes with its 0
call PlaySound        | new | - | a:id:u8 | - | a system sound on VERA's PSG voices 14 and 15, played by the interrupt (the call returns at once; DECISIONS V69): SND_ERROR (Beep's), SND_WARNING, SND_ALARM, SND_STARTUP, SND_EXIT, SND_APP, SND_OPEN, SND_CLOSE, SND_MENU, SND_TRASH; a new sound replaces the one playing, but nothing replaces the alarm; silent with the settings' sounds off (PREFS_NOSOUND) but the alarm, SND_MENU only with PREFS_MENUTICK; the volume the settings' (PREFS_VOLUME); the kernel plays them at its own events (start-up, an application's start, a desk accessory's, a question's dialog box, a menu, the alarm, the way to BASIC); a, x, y: a changed (API 4)
const SND_ERROR     | 1     | PlaySound: an error (Beep)
const SND_WARNING   | 2     | PlaySound: a warning or a question (a dialog box with YES and NO plays it)
const SND_ALARM     | 3     | PlaySound: the alarm (plays with the sounds off; nothing cuts it)
const SND_STARTUP   | 4     | PlaySound: the start-up chime (the first program after boot)
const SND_EXIT      | 5     | PlaySound: leaving Veranda (ToBASIC plays it to its end)
const SND_APP       | 6     | PlaySound: an application starts
const SND_OPEN      | 7     | PlaySound: a desk accessory opens (or a window)
const SND_CLOSE     | 8     | PlaySound: a desk accessory closes (or a window)
const SND_MENU      | 9     | PlaySound: a menu tick (only with PREFS_MENUTICK)
const SND_TRASH     | 10    | PlaySound: the trash emptied

# ---------------------------------------------------------------- the switcher (DECISIONS V83)
call TaskCtl          | new | - | a:op:u8 x:task:u8 r0:buffer:ptr | x:error:u8 | the switcher: applications put aside whole into RAM banks (their RAM, zero page, system variables, the menus' and dialog boxes' state, their open record file and overlays, VRAM with both screens and the colour map, packed) and brought back exactly as they were; one full-screen application runs at a time (DECISIONS V83). a = TASK_INFO: task x (0 .. TASK_MAX - 1) to r0, TASK_REC bytes (TR_STATE: 0 free, TASK_ASIDE; TR_BANKS the RAM banks it holds; TR_NAME its GEOS name, 17 bytes; TR_NOTE the note it was started with, TASK_NOTE_LEN bytes), a = its state; x = $FF: the summary to r0, TASK_SUM bytes (TS_COUNT tasks put aside, TS_FREE free RAM banks, TS_BANKS RAM banks there are for programs, TS_ERR the error of the last start that failed and sent the desktop instead (NO_BANKS ...), cleared by this read, TS_NAME its name, 17 bytes); TASK_RESUME: task x comes back, where it was, and the caller ends (as by GetFile: its streams closed, its banks freed; returns only on an error); TASK_END: task x is dropped, its banks freed (what it had not saved is lost); TASK_NOTE: r0's text (up to TASK_NOTE_LEN bytes with its 0, below $A000) goes with the next application that starts and stays with it while it is aside (the shell: the program's path); TASK_ASIDE: switchReq = SWITCH_ASIDE (the caller is put aside at its main loop's next pass); TASK_ROOM: a = the RAM banks the caller may still take (API 7; DECISIONS V145: in Roomy mode a program that does not fit in the free banks is put aside onto the card); x = 0, else the error (INV_RECORD: no such task or op); r0-r3 changed (API 6)
const TASK_INFO       | 0   | TaskCtl: a task's record, or (x = $FF) the summary
const TASK_RESUME     | 1   | TaskCtl: bring task x back; the caller ends
const TASK_END        | 2   | TaskCtl: drop task x (its banks freed)
const TASK_NOTE       | 3   | TaskCtl: r0's note goes with the next application started
const TASK_ASIDE      | 4   | TaskCtl: put the caller aside at the main loop's next pass (switchReq); TaskCtl(TASK_INFO): a task's state, put aside
const TASK_ROOM       | 5   | TaskCtl: a = the RAM banks the caller may still take with BankAlloc and be put aside (Fast: the free banks less the desktop's reserve and a small program's packed data; Roomy: the free banks and those of the programs aside in RAM, less two) (API 7)
const TASK_MAX        | 8   | TaskCtl: tasks that can be put aside at once
const TASK_NOTE_LEN   | 96  | TaskCtl: a note's bytes with its 0
const TASK_REC        | 115 | TaskCtl(TASK_INFO): a task's record's bytes
const TR_STATE        | 0   | TaskCtl's record: the state
const TR_BANKS        | 1   | TaskCtl's record: the RAM banks it holds
const TR_NAME         | 2   | TaskCtl's record: its GEOS name (17 bytes)
const TR_NOTE         | 19  | TaskCtl's record: its note (TASK_NOTE_LEN bytes)
const TASK_SUM        | 21  | TaskCtl(TASK_INFO, $FF): the summary's bytes
const TS_COUNT        | 0   | TaskCtl's summary: tasks put aside
const TS_FREE         | 1   | TaskCtl's summary: free RAM banks
const TS_BANKS        | 2   | TaskCtl's summary: RAM banks for programs
const TS_ERR          | 3   | TaskCtl's summary: the error of the last start that failed (0 none; cleared by the read)
const TS_NAME         | 4   | TaskCtl's summary: that program's name (17 bytes)
const SWITCH_ASIDE    | $80 | switchReq: put the application aside at the main loop's next pass
const APPF_STAY       | 4   | an application's info block flags (byte 143) bit 2: it is never put aside; the switcher asks to quit it instead (API 6)
