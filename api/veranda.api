# Veranda API table: the single source for the jump table, the assembly
# includes, the C header and library, and the reference (tools/apigen.py).
#
# Lines (fields separated by "|", blanks around them ignored):
#
#   call NAME | KIND | SLOT | IN | OUT | DESCRIPTION
#     KIND  classic  a GEOS call: kept at its GEOS position (SLOT = its
#                    GEOS 64 address, the Veranda address is
#                    CLASSIC_BASE + SLOT - $C100), same registers
#           drop     a GEOS position that Veranda does not implement: the
#                    entry returns x = UNSUPPORTED (and c set)
#           wide     the 16-bit Y twin of a classic call (W + its name)
#           new      a call GEOS does not have
#           Wide and new calls get the next slot of the second table
#           (SLOT "-"), in the order of this file; once released, a slot
#           never moves.
#     IN / OUT  space separated REG:NAME:TYPE. REG is a, x, y, c (carry),
#           n (negative flag), r0..r15 (words), r0L/r0H .. (bytes),
#           inline (parameters follow the jsr: no C binding), "-" none.
#           TYPE: u8 i8 u16 i16 ptr flag. C bindings take IN in order and
#           return the first OUT (others stay in the registers, readable
#           as the C variables r0..r15).
#     Flags in the DESCRIPTION: [noc] no C binding, [noreturn].
#
#   var NAME | ADDR | SIZE | DESCRIPTION         system variable
#   const NAME | VALUE | DESCRIPTION             constant
#   area NAME | ADDR | SIZE | DESCRIPTION        memory map
#   path NAME | TEXT | DESCRIPTION              a folder of the card's layout
#                                                (a string: #define / .define)
#
# Register conventions of the wide calls: X as in GEOS (r3, r4; text: r11);
# Y in full words: a single y or the top in r11 (text: r12), the bottom in
# r12 (lines: the second point's y). Wide calls take no flags as inputs: a
# mode byte in a instead.

# ---------------------------------------------------------------- memory map
area ZP_GEOS        | $0022 | 46    | GEOS system variables (same addresses as GEOS)
area ZP_APP1        | $0050 | 48    | application zero page (a0-a9 first)
area ZP_ROM         | $0080 | 41    | X16 ROM: KERNAL, DOS, reserved, audio; never touched
area ZP_APP2        | $00A9 | 87    | application zero page (cc65's goes here)
area OS_VARS        | $0400 | 1024  | system variables (below)
area APP_RAM        | $0801 | 32767 | application RAM ($0801-$87FF)
area RESIDENT       | $8800 | 5888  | resident core: jump tables, gates, interrupt entry
area BANK_WINDOW    | $A000 | 8192  | kernel banks or the application's banks
const CLASSIC_BASE  | $8800 | the classic jump table (GEOS 64 address - $3900)
const NEW_BASE      | $8A00 | the table of wide and new calls
const API_LEVEL     | 7     | GetVersion returns it; an application may ask for at most this

# ---------------------------------------------------------------- the card's folders
# (DECISIONS V71: the layout, defined here once; the SDK's vrpath.h goes
# there with the fallbacks: no /VERANDA, the root; no APPS, /VERANDA)
path VR_SYSDIR      | /VERANDA                | the system folder: VERANDA.PRG, VERANDA.SYS, RBOOT, SHELL.cvt, DESKTOP.cvt
path VR_APPSDIR     | /VERANDA/APPS           | the applications and desk accessories
path VR_DATADIR     | /VERANDA/.SYSTEM        | the system's data (hidden): settings, alarms, the scraps, Note File, the albums, SHELL.DSK, the trash
path VR_FONTSDIR    | /VERANDA/FONTS          | the fonts
path VR_DOCSDIR     | /DOCUMENTS              | the user's documents: where programs save and open first, where the shell opens
path VR_TRASHDIR    | /VERANDA/.SYSTEM/TRASH  | the trash
path VR_WALLDIR     | /VERANDA/WALLPAPERS     | the desktop pictures (V78): Dusk.cvt, the default, and the user's (tools/mkwall.py)
path VR_HELPDIR     | /VERANDA/HELP           | the help files (V93): VeraBASIC's KEYWORDS.HLP, TUTORIAL.HLP, ERRORS.HLP, EDITOR.HLP; other programs' help may go here too
path VR_SYSPATH     | //VERANDA/:             | VR_SYSDIR in CMD's syntax, for FOpen by a path
path VR_DATAPATH    | //VERANDA/.SYSTEM/:     | VR_DATADIR in CMD's syntax
path VR_FONTSPATH   | //VERANDA/FONTS/:       | VR_FONTSDIR in CMD's syntax
path VR_HELPPATH    | //VERANDA/HELP/:        | VR_HELPDIR in CMD's syntax
path VR_ROOTPATH    | //:                     | the root in CMD's syntax

# ---------------------------------------------------------------- registers
var r0   | $02 | 2 | pseudo register
var r1   | $04 | 2 | pseudo register
var r2   | $06 | 2 | pseudo register
var r3   | $08 | 2 | pseudo register
var r4   | $0A | 2 | pseudo register
var r5   | $0C | 2 | pseudo register
var r6   | $0E | 2 | pseudo register
var r7   | $10 | 2 | pseudo register
var r8   | $12 | 2 | pseudo register
var r9   | $14 | 2 | pseudo register
var r10  | $16 | 2 | pseudo register
var r11  | $18 | 2 | pseudo register
var r12  | $1A | 2 | pseudo register
var r13  | $1C | 2 | pseudo register
var r14  | $1E | 2 | pseudo register
var r15  | $20 | 2 | pseudo register
var a0   | $50 | 2 | application register
var a1   | $52 | 2 | application register
var a2   | $54 | 2 | application register
var a3   | $56 | 2 | application register
var a4   | $58 | 2 | application register
var a5   | $5A | 2 | application register
var a6   | $5C | 2 | application register
var a7   | $5E | 2 | application register
var a8   | $60 | 2 | application register
var a9   | $62 | 2 | application register

# ---------------------------------------------------------------- zero page variables (GEOS addresses)
var curPattern     | $22 | 2 | pointer to the current fill pattern
var string         | $24 | 2 | pointer used by text routines
var baselineOffset | $26 | 1 | current font: baseline
var curSetWidth    | $27 | 2 | current font: bytes per scanline of its bitmap
var curHeight      | $29 | 1 | current font: height
var curIndexTable  | $2A | 2 | current font: offset table
var cardDataPntr   | $2C | 2 | current font: bitmap
var currentMode    | $2E | 1 | text style bits
var dispBufferOn   | $2F | 1 | bit 7 draw to the foreground, bit 6 to the back screen
var mouseOn        | $30 | 1 | mouse and menu state bits
var msePicPtr      | $31 | 2 | pointer picture
var windowTop      | $33 | 1 | clip window top (classic byte view)
var windowBottom   | $34 | 1 | clip window bottom (classic byte view)
var leftMargin     | $35 | 2 | text: left margin
var rightMargin    | $37 | 2 | text: right margin
var pressFlag      | $39 | 1 | input event bits
var mouseXPos      | $3A | 2 | pointer x
var mouseYPos      | $3C | 1 | pointer y (classic byte view; mouseYPosW is the real one)
var returnAddress  | $3D | 2 | inline calls: return address

# ---------------------------------------------------------------- system variables ($0400-$07FF)
var fileHeader     | $0400 | 256 | the info block of the last file opened (GEOS layout)
var dirEntryBuf    | $0500 | 30  | the directory entry of the last file found (GEOS layout)
var curRecord      | $051E | 1   | record file: current record
var usedRecords    | $051F | 1   | record file: records in use
var fileWritten    | $0520 | 1   | record file: changed since opened
var fileSize       | $0521 | 2   | record file: size in blocks of 254 bytes
var appMain        | $0523 | 2   | called every main loop pass
var intTopVector   | $0525 | 2   | called at the start of the interrupt
var intBotVector   | $0527 | 2   | called at the end of the interrupt
var mouseVector    | $0529 | 2   | called on a click
var keyVector      | $052B | 2   | called on a key
var inputVector    | $052D | 2   | called on input device changes
var mouseFaultVec  | $052F | 2   | called when the pointer leaves its region
var otherPressVec  | $0531 | 2   | called on a click not on a menu or icon
var StringFaultVec | $0533 | 2   | called when GetString's input is too long
var alarmTmtVector | $0535 | 2   | called when the alarm goes off
var BRKVector      | $0537 | 2   | called on BRK
var RecoverVector  | $0539 | 2   | recovers areas under menus and dialogs (r2L top, r2H bottom, r3 left, r4 right; r11, r12 wide); 0: Veranda chooses (the save-under stack if the application draws to the foreground only, else the back screen)
var selectionFlash | $053B | 1   | icon and menu flash time
var alphaFlag      | $053C | 1   | text prompt state
var iconSelFlg     | $053D | 1   | icon selection behaviour
var faultData      | $053E | 1   | pointer fault bits
var menuNumber     | $053F | 1   | menu level
var mouseTop       | $0540 | 1   | pointer region top (classic byte view)
var mouseBottom    | $0541 | 1   | pointer region bottom (classic byte view)
var mouseLeft      | $0542 | 2   | pointer region left
var mouseRight     | $0544 | 2   | pointer region right
var stringX        | $0546 | 2   | GetString: x
var stringY        | $0548 | 1   | GetString: y (classic byte view)
var keyData        | $0549 | 1   | the last key
var mouseData      | $054A | 1   | bit 7 = button up
var inputData      | $054B | 1   | input device data
var random         | $054C | 2   | changes every interrupt
var dblClickCount  | $054E | 1   | double click timer
var year           | $054F | 1   | clock
var month          | $0550 | 1   | clock
var day            | $0551 | 1   | clock
var hour           | $0552 | 1   | clock
var minutes        | $0553 | 1   | clock
var seconds        | $0554 | 1   | clock
var alarmSetFlag   | $0555 | 1   | alarm state
var sysDBData      | $0556 | 1   | the dialog box result
var curDrive       | $0557 | 1   | always 8: the SD card
var graphMode      | $0558 | 1   | the video mode (SetVideoMode)
var pointerShape   | $0559 | 1   | the pointer's shape as SetPointer set it (PTR_ARROW ...); 0 when an application starts (API 2)
var blankDelay     | $055A | 2   | seconds without input (a key, a pointer move, a button) before the screen blanks (VERA's display window closed: the whole screen the border, palette entry 0 black; DC_VIDEO and VRAM untouched); 600 at start-up, 0: never; the key or pointer move that wakes it is not passed on (API 2)
var uiFont         | $055C | 1   | the font native programs' menus and dialog boxes use: 0 the system font (as GEOS: classic tables keep it), else a font's handle (FONT_UI, or one from LoadFont); 0 when a program or accessory starts (API 3)
var uiLook         | $055D | 1   | the look of a native program's menus (DECISIONS V74): 0 GEOS 64's (classic tables keep it); LOOK_BAR the Veranda look: a horizontal main menu becomes the full-width menu bar (the Veranda mark, item 0 in bold: the program's name, its menus on 8-pixel cards, the sound and the date and time at the right, kept up to date), vertical menus open under their item with 16-line items and no separators; bits 0-3 (LOOK_HILITE) a palette entry: the bar's cards in entry 2 (the chrome) and an open menu or a chosen item in that colour (the colour map) instead of inverted; 0 when a program or accessory starts (API 4)
var longNames      | $055E | 1   | the GEOS file calls' names (DECISIONS V82): 0 GEOS's, at most 16 characters (as GEOS: classic programs keep it); LONG_NAMES: FindFile, GetFile (the program and its document, r6 and r3), OpenRecordFile, SaveFile, DeleteFile, LdFile and GetFHdrInfo after FindFile take FAT names of up to LONG_MAX characters (0-terminated; a GEOS file's name without its ".cvt"); 0 when a program or accessory starts (API 5)
var clipOn         | $055F | 1   | the clip rectangle (DECISIONS V81): 0 off (as GEOS: every call as before); not 0: the drawing (WRectangle, WInvertRectangle, WRecoverRectangle, WImprintRectangle, WFrameRectangle, the lines and points, the text, WBitmapUp and the rows) touches only the pixels in leftMargin .. rightMargin by windowTopW .. windowBottomW (a character partly in them drawn so; one wholly left or right of them skipped, without StringFaultVec), WVerticalLine (bank T) too; PutCards, CopyRect, ScrollRect and the colours are not clipped; 0 when a program or accessory starts (API 5)
var mouseYPosW     | $0560 | 2   | pointer y
var windowTopW     | $0562 | 2   | clip window top
var windowBottomW  | $0564 | 2   | clip window bottom
var mouseTopW      | $0566 | 2   | pointer region top
var mouseBottomW   | $0568 | 2   | pointer region bottom
var stringYW       | $056A | 2   | GetString: y
var screenWidth    | $056C | 2   | pixels
var screenHeight   | $056E | 2   | lines
var mouseButtons   | $0570 | 1   | bit 0 left, 1 right, 2 middle (1 = down)
var mouseWheel     | $0571 | 1   | wheel movement since the last read (signed)
var keyMods        | $0572 | 1   | modifier keys: bit 0 shift, 1 ctrl, 2 alt, 3 Commodore/GUI
var appBank        | $0573 | 1   | the RAM bank mapped when Veranda calls the application (vectors, processes, Sleep)
var mouseSource    | $0574 | 2   | 0: the X16 mouse; else a routine (in the interrupt): r0 = x, r1 = y, a = buttons; c clear: a device position (the pointer moves by its change), c set: the pointer's position (limited to the region)
var dosStatus      | $0576 | 1   | the last CMDR-DOS status (two digits as a number: 0 ok, 62 not found, 63 exists ...)
var keyDataMods    | $0577 | 1   | the modifier keys held when keyData (or GetNextChar's key) was typed, as keyMods; bit 4 (KEYM_ARROW): an arrow key (KEY_LEFT is BACKSPACE's code) (API 2)
var switchReq      | $057A | 1   | SWITCH_ASIDE (bit 7): at the main loop's next pass (at its top level: not inside a dialog box, not while a desk accessory runs) the running application is put aside whole into RAM banks and the desktop comes, with the application in its dock (DECISIONS V83); Alt+Tab and TaskCtl(TASK_ASIDE) set it, the kernel clears it; a program that cannot be put aside (its info block's flag APPF_STAY, streams or a listing open, not enough RAM banks) gets a box that asks whether it may quit; nothing for the desktop itself (API 6)
var intFirstVector | $0578 | 2   | called first in every interrupt, before Veranda saves anything (the interrupted code's banks mapped, a x y free, at most a few hundred cycles, or longer with its own source masked and interrupts on: PCM from AFLOW, V52); return c set when its device needs nothing more: if VERA has no enabled interrupt pending either, the interrupt ends there (a serial port's FIFO, VERA's line interrupt); 0: none; cleared when an application or accessory starts (API 2)
var asideVector    | $057B | 2   | called by the switcher (DECISIONS V91) just before it puts the running application aside or asks whether it may quit it (switchReq: Alt+Tab, TaskCtl(TASK_ASIDE)), from the main loop's top level (the application's bank mapped, interrupts on, r0-r15 free): a program whose device interrupts through intFirstVector turns the device's interrupt off there, since the kernel stops calling intFirstVector next (and turns VERA's line interrupt off); nothing is called when the program comes back, or goes on (the box's Cancel): it arms the device again from its main loop (appMain); 0: none; cleared when an application or accessory starts
var deskNote       | $057D | 1   | why the kernel opened the desk accessory that runs (DECISIONS V120): a click on the menu bar's clock opens Preferences with DN_CLOCK (its date and time), on its sound with DN_VOLUME (the volume pop-up under the pointer); 0 for an accessory a program opened (GetFile); the kernel sets it before its GetFile and clears it after
const DN_CLOCK       | 1     | deskNote: the menu bar's clock was clicked (Preferences: the date and time)
const DN_VOLUME      | 2     | deskNote: the menu bar's sound was clicked (Preferences: the volume pop-up)
var dataFileName   | $0580 | 17  | GetFile: a document's name; a name longer than 16 characters (dataLongName) in its short form (DECISIONS V82: the first 11 characters less the extension's, "~", the CRC-16 of the long name in 4 hexadecimal digits, the extension of up to 4 characters with its dot), which every GEOS file call and FOpen take for the long one
var curDirName     | $05A0 | 64  | the current directory (path)
var dbFileNames    | $0600 | 442 | a dialog box's file list (DBGETFILES): up to DB_MAX_FILES names of 17 bytes, in the order found
var dataLongName   | $07C0 | 64  | GetFile: a document's whole name (up to LONG_MAX characters and a 0: a GEOS document's without ".cvt", a plain file's with its extension); dataFileName holds it, or its short form when it is longer than 16 (API 5)

# ---------------------------------------------------------------- constants
const KEY_F1          | 1   | key code
const KEY_F2          | 2   | key code
const KEY_F3          | 3   | key code
const KEY_F4          | 4   | key code
const KEY_F5          | 5   | key code
const KEY_F6          | 6   | key code
const KEY_TAB         | 9   | key code
const KEY_F7          | 14  | key code
const KEY_F8          | 15  | key code
const KEY_UP          | 16  | key code
const KEY_DOWN        | 17  | key code
const KEY_HOME        | 18  | key code
const KEY_CLEAR       | 19  | key code
const KEY_STOP        | 22  | key code
const KEY_ESC         | 27  | key code
const KEY_INSERT      | 28  | key code
const KEY_DELETE      | 29  | key code
const KEY_RIGHT       | 30  | key code
const KEY_LEFT        | 8   | key code (BACKSPACE)
const SHORTCUT        | $80 | key code bit: Alt (Commodore) + a key
const KEY_PGUP        | $81 | key code (API 2)
const KEYM_ARROW      | $10 | keyDataMods bit: the key was an arrow key (API 2)
const KEY_PGDN        | $82 | key code (API 2; without Ctrl: Ctrl+B is 2)
const KEY_END         | $83 | key code (API 2; without Ctrl: Ctrl+D is 4)
const KEY_F9          | $89 | key code (API 2)
const KEY_F10         | $8A | key code (API 2)
const KEY_F11         | $8B | key code (API 2)
const KEY_F12         | $8C | key code (API 2)
const CLICK_COUNT     | 30  | frames for a double click
const MOUSE_SPRNUM    | 0   | the pointer's sprite
const ST_FLASH        | $80 | iconSelFlg: flash a selected icon
const ST_INVERT       | $40 | iconSelFlg: invert a selected icon
const ST_WR_FORE      | $80 | dispBufferOn: draw to the foreground
const ST_WR_BACK      | $40 | dispBufferOn: draw to the back screen
const ST_WRGS_FORE    | $20 | dispBufferOn: GetString and GraphicsString to the foreground only (dialog boxes)
const MODE_640x480    | 0   | video mode
const MODE_640x240    | 1   | video mode
const MODE_320x240    | 2   | video mode
const DRAW_ERASE      | 0   | wide line and point mode: paper
const DRAW_INK        | 1   | wide line and point mode: ink
const DRAW_RECOVER    | $80 | wide line and point mode: from the back screen
const UNSUPPORTED     | $FE | x on return of a dropped GEOS call
const HORIZONTAL      | $00 | menu
const VERTICAL        | $80 | menu
const CONSTRAINED     | $40 | menu
const UN_CONSTRAINED  | $00 | menu
const MENU_ACTION     | $00 | menu item
const SUB_MENU        | $80 | menu item
const DYN_SUB_MENU    | $40 | menu item
const WIDE_MENU       | $20 | menu flags byte (offset 6): two more bytes follow it, the high bytes of top and bottom; items from offset 9
const WIDE_ICONS      | $80 | icon table count byte: the pointer y is a word (header 5 bytes) and each icon 10 bytes, the high bytes of y and height last
const WIDE_DB         | $20 | dialog box's first byte: its own position has word Y fields (bits 0-4: shadow)
const DEF_DB_POS      | $80 | dialog box at the default position
const SET_DB_POS      | $00 | dialog box at its own position
const OK              | 1   | dialog icon and result
const CANCEL          | 2   | dialog icon and result
const YES             | 3   | dialog icon and result
const NO              | 4   | dialog icon and result
const OPEN            | 5   | dialog icon and result
const DISK            | 6   | dialog icon and result
const DBTXTSTR        | 11  | dialog item: text
const DBVARSTR        | 12  | dialog item: text through a register
const DBGETSTRING     | 13  | dialog item: text input
const DBSYSOPV        | 14  | dialog item: a click anywhere closes it
const DBGRPHSTR       | 15  | dialog item: GraphicsString
const DBGETFILES      | 16  | dialog item: file list (r7L type, r10 class or 0, r5 the name chosen); also the result when no file matches
const DB_MAX_FILES    | 26  | DBGETFILES: the most names listed (30 before API 5: dataLongName took the end of dbFileNames)
const LONG_NAMES      | 1   | longNames: the file calls take long names (API 5)
const LONG_MAX        | 63  | the longest name the file calls take (longNames, dataLongName)
const DBOPVEC         | 17  | dialog item: user vector on a click
const DBUSRICON       | 18  | dialog item: user icon
const DB_USR_ROUT     | 19  | dialog item: user routine
const EOF             | 0   | string end
const BACKSPACE       | 8   | string code
const FORWARDSPACE    | 9   | string code
const TAB             | 9   | string code
const LF              | 10  | string code: next line
const HOME            | 11  | string code: top left
const UPLINE          | 12  | string code: line up
const PAGE_BREAK      | 12  | string code (documents)
const CR              | 13  | string code: next line, left margin
const ULINEON         | 14  | string code: underline on
const ULINEOFF        | 15  | string code: underline off
const ESC_GRAPHICS    | 16  | string code: a GraphicsString follows
const ESC_RULER       | 17  | string code (documents)
const REV_ON          | 18  | string code: reverse on
const REV_OFF         | 19  | string code: reverse off
const GOTOX           | 20  | string code: .word x
const GOTOY           | 21  | string code: .byte y
const GOTOXY          | 22  | string code: .word x, .byte y
const NEWCARDSET      | 23  | string code: .word font
const BOLDON          | 24  | string code: bold on
const ITALICON        | 25  | string code: italic on
const OUTLINEON       | 26  | string code: outline on
const PLAINTEXT       | 27  | string code: all styles off
const SET_UNDERLINE   | $80 | currentMode bit
const SET_BOLD        | $40 | currentMode bit
const SET_REVERSE     | $20 | currentMode bit
const SET_ITALIC      | $10 | currentMode bit
const SET_OUTLINE     | $08 | currentMode bit
const SET_SUPERSCRIPT | $04 | currentMode bit
const SET_SUBSCRIPT   | $02 | currentMode bit
const SET_PLAINTEXT   | $00 | currentMode
const SET_LEFTJUST    | $80 | PutDecimal format
const SET_RIGHTJUST   | $00 | PutDecimal format
const SET_SURPRESS    | $40 | PutDecimal format: no leading zeros
const SET_NOSURPRESS  | $00 | PutDecimal format
const MOVEPENTO       | 1   | GraphicsString: .word x, .byte y
