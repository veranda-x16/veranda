call WDrawPoint       | wide | - | a:mode:u8 r3:x:u16 r11:y:u16 | - | DrawPoint
call WTestPoint       | wide | - | r3:x:u16 r11:y:u16 | a:set:u8 | a = 1 if the pixel is set (c too)
call WBitmapUp        | wide | - | r0:bitmap:ptr r1L:x:u8 r2L:width:u8 r11:y:u16 r12:height:u16 | - | BitmapUp; x and width in cards; height bit 15 (DECISIONS V81): raw rows, width bytes each, no compaction (with the clip off and the bitmap on the screen a column at a time, VERA stepping by the stride: some 5 times as fast) (API 5)
call WPutChar         | wide | - | a:char:u8 r11:x:u16 r12:y:u16 | - | PutChar
call WPutString       | wide | - | r0:string:ptr r11:x:u16 r12:y:u16 | - | PutString
call WSmallPutChar    | wide | - | a:char:u8 r11:x:u16 r12:y:u16 | - | SmallPutChar
call WPutDecimal      | wide | - | a:format:u8 r0:value:u16 r11:x:u16 r12:y:u16 | - | PutDecimal
